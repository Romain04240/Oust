          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers du cloud : %@. Ils sont dans la corbeille de leur service, que le Finder montre avec celle du Mac ; ils se restaurent depuis l’Historique tant qu’elle n’est pas vidée."
          }
        }
      }
    },
