      }
    },
    "mcp.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! frees disk space on this Mac, safely and locally. Call scan first: it lists what can be freed (freeable size, safety class, method, rebuild cost, protections) and returns a preview token. Use explain on an ID before acting if unsure. clean requires that token and only accepts IDs the scan showed: “safe” and “rebuilds” items by default, “review” items only with allowReview after asking the user, never protected items, never anything needing an administrator password. Prefer dryRun first. Everything cleaned goes to Oust!’s history; personal content goes to the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! libère de l’espace sur ce Mac, en toute sécurité et sans réseau. Appelez d’abord scan : il liste ce qui peut être libéré (taille libérable, classe de sécurité, méthode, coût de reconstruction, protections) et rend un jeton d’aperçu. En cas de doute, explain sur un identifiant avant d’agir. clean exige ce jeton et n’accepte que des identifiants montrés par l’analyse : « safe » et « rebuilds » par défaut, « review » seulement avec allowReview après avoir demandé à l’utilisateur, jamais un élément protégé, jamais ce qui demande un mot de passe administrateur. Préférez d’abord dryRun. Tout ce qui est nettoyé entre à l’historique d’Oust! ; le contenu personnel part dans la corbeille du Mac."
          }
        }
      }
    },
    "mcp.param.allowReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also allow items of class “review” (personal or costly to get back). Ask the user first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser aussi les éléments de classe « review » (personnels ou coûteux à retrouver). Demandez d’abord à l’utilisateur."
          }
        }
      }
    },
    "mcp.param.dryRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check everything and report what would happen, without touching anything."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout vérifier et dire ce qui se passerait, sans rien toucher."
          }
        }
      }
    },
    "mcp.param.finders": {
      "extractionState": "manual",
      "localizations": {
