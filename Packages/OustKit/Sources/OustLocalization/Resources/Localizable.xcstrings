      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving a file to the Trash deletes it in the cloud and on your other devices too. It stays recoverable from the Mac’s Trash, then according to the service."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre un fichier à la corbeille le supprime aussi dans le cloud et sur vos autres appareils. Il reste récupérable depuis la corbeille du Mac, puis selon le service."
          }
        }
      }
    },
    "clouds.honesty.listed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what a service has already listed on this Mac shows up here. Google Drive in streaming mode lists a folder only once it has been opened in the Finder; iCloud Drive can leave whole folders in the cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne voit ici que ce que le service a déjà listé sur ce Mac. Google Drive en mode « flux » ne liste un dossier qu’une fois ouvert dans le Finder ; iCloud Drive peut laisser des dossiers entiers dans le cloud."
          }
        }
      }
    },
    "clouds.honesty.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! never signs in to your accounts and downloads nothing: sizes and dates come from the placeholders each service keeps on this Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! ne se connecte à aucun compte et ne télécharge rien : tailles et dates viennent des fichiers fantômes que chaque service garde sur ce Mac."
          }
        }
      }
    },
    "clouds.honesty.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
