    "clouds.account_app_closed_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open %@, then Read again: macOS only links this account to its service while the app is open. Until then, its files stay listed, but none can be deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez %@, puis « Relire » : macOS ne relie ce compte à son service que quand l’app est ouverte. D’ici là, ses fichiers restent listés, mais aucun ne peut être supprimé."
          }
        }
      }
    },
