          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scripts qu’une application en bac à sable a le droit de lancer, souvent ajoutés par vous."
          }
        }
      }
    },
    "rule.uninstall.applicationSupport.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only from the Mac’s Trash. Check it before emptying the Trash if the app held your work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement depuis la corbeille du Mac. À vérifier avant de la vider si l’application gardait votre travail."
          }
        }
      }
    },
    "rule.uninstall.applicationSupport.title": {
      "extractionState": "manual",
      "localizations": {
