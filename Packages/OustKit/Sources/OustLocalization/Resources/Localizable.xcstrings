    "archive.activity_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects are found in nested folders too. Activity is estimated from source changes, excluding Git metadata and common dependency and build folders. Choose “All projects” to review recent projects as well."
          }
        },
