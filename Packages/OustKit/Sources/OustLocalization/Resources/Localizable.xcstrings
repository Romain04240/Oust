    "storage.details.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System and unattributed storage"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
