    "method.archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied to the archive disk and checked file by file, then moved to the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié sur le disque d’archive et vérifié fichier par fichier, puis mis dans la corbeille du Mac."
          }
        }
      }
    },
    "method.brewCleanup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaned up by Homebrew itself (brew cleanup)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyé par Homebrew lui-même (brew cleanup)."
          }
        }
      }
    },
    "method.cloneOf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaced by a clone of the original: same file, no extra space."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacé par un clone de l’original : même fichier, plus d’espace en double."
          }
        }
      }
    },
    "method.compressInPlace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed in place by APFS; each file is read back and compared before it replaces the original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressé sur place par APFS ; chaque fichier est relu et comparé avant de remplacer l’original."
          }
        }
      }
    },
    "method.containerPrune": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed by Docker or OrbStack itself (docker builder prune, image rm, container rm)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiré par Docker ou OrbStack lui-même (docker builder prune, image rm, container rm)."
          }
        }
      }
    },
    "method.evictLocalCopy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local copy removed; the file stays in the cloud and downloads again when opened."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie locale retirée ; le fichier reste dans le nuage et se retélécharge à l’ouverture."
          }
        }
      }
    },
    "method.firefoxHistory": {
      "extractionState": "manual",
