    "transfer.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move these originals after verification?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer ces originaux après vérification ?"
          }
        }
      }
