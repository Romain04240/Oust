    "agent.error.previewRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent scan shows these items: run oust scan first (a preview lasts 30 minutes)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune analyse récente ne montre ces éléments : lancez d’abord oust scan (un aperçu vaut 30 minutes)."
          }
        }
      }
    },
    "agent.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refused, nothing was cleaned: %@."
