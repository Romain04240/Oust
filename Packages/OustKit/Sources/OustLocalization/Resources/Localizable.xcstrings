          "stringUnit": {
            "state": "translated",
            "value": "A small pill under the menu bar when free space falls below the threshold: once, not every minute, then it leaves on its own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pastille sous la barre des menus quand l’espace libre passe sous le seuil : une fois, pas chaque minute, puis elle repart seule."
          }
        }
      }
    },
    "settings.watch.alert_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small pill floats under the menu bar each time a disk’s free space falls below the threshold, once and not every minute, then leaves on its own. Its outline shows how full the disk is. The startup disk and the disks you plug in; not Time Machine backups, read-only disk images or network disks. When an analysis is known, it says what Oust! can reclaim without risk. Click it for the details in Oust!, swipe it up to dismiss it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pastille flotte sous la barre des menus chaque fois que l’espace libre d’un disque passe sous le seuil, une fois et pas chaque minute, puis repart seule. Son contour montre le remplissage du disque. Le disque de démarrage et les disques branchés ; pas les sauvegardes Time Machine, les images disque en lecture seule ni les disques réseau. Si une analyse est connue, elle dit ce qu’Oust! peut récupérer sans risque. Un clic montre le détail dans Oust!, un balayage vers le haut la ferme."
          }
        }
      }
    },
    "settings.watch.alert_preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayer"
          }
        }
      }
    },
    "settings.watch.alert_scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The startup disk and the disks you plug in; not Time Machine backups, read-only disk images or network disks. The pill’s outline shows how full the disk is; when an analysis is known, it says what Oust! can give back without risk. Click it for the details in Oust!, swipe it up to dismiss it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque de démarrage et les disques branchés ; pas les sauvegardes Time Machine, les images disque en lecture seule ni les disques réseau. Le contour de la pastille montre le remplissage du disque ; si une analyse est connue, elle dit ce qu’Oust! peut rendre sans risque. Un clic montre le détail dans Oust!, un balayage vers le haut la ferme."
          }
        }
      }
    },
