            "value": "Removed with git worktree remove; the branch is kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retiré par git worktree remove ; la branche est conservée."
          }
        }
      }
    },
    "method.localSnapshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted with tmutil, with administrator rights."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé par tmutil, avec les droits d’administrateur."
          }
        }
      }
    },
    "method.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown for information: manage it in its own app."
          }
