    "rule.attachments.mail.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachments that Mail downloaded from received messages, grouped by year. The messages themselves are never touched, and attachments from the last 30 days are left out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes que Mail a téléchargées depuis les messages reçus, regroupées par année. Les messages eux-mêmes ne sont jamais touchés, et celles des 30 derniers jours sont laissées de côté."
          }
        }
      }
    },
    "rule.attachments.messages.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Messages in iCloud, they can be downloaded again; otherwise they only come back from the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Messages dans iCloud, elles peuvent se retélécharger ; sinon, elles ne reviennent que depuis la corbeille du Mac."
          }
        }
      }
    },
    "rule.attachments.messages.title": {
