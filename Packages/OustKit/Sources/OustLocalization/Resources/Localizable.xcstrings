    "feedback.body.bug": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What were you doing?\n\n\nWhat happened?\n\n\nWhat did you expect?\n\n\nCan you make it happen again? How?\n\n\n(A screenshot helps a lot: drop it into this email.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que faisiez-vous ?\n\n\nQue s’est-il passé ?\n\n\nÀ quoi vous attendiez-vous ?\n\n\nPouvez-vous le refaire ? Comment ?\n\n\n(Une capture d’écran aide beaucoup : glissez-la dans ce message.)"
          }
        }
      }
    },
    "feedback.body.idea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your idea:\n\n\nWhat it would help you with:\n\n\nHow you picture it in Oust! (optional):\n\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre idée :\n\n\nÀ quoi elle vous servirait :\n\n\nComment vous la voyez dans Oust! (facultatif) :\n\n"
          }
        }
      }
    },
    "feedback.body.other": {
