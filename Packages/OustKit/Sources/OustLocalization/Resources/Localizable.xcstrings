    "photos.access_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! reads your library through Photos and never touches its files. Nothing leaves your Mac, and nothing is deleted without your confirmation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! lit votre photothèque par Photos, sans jamais toucher à ses fichiers. Rien ne quitte votre Mac, et rien n’est supprimé sans votre confirmation."
          }
        }
      }
    },
