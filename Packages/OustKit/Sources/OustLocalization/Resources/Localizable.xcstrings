    "transfer.plan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ items · %@ to copy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ éléments · %@ à copier"
          }
        }
      }
    },
    "transfer.planNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All copies must finish and pass verification before originals can go to the Mac’s Trash. If a copy fails, all originals stay in place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les copies doivent être terminées et vérifiées avant la mise à la corbeille du Mac des originaux. Si une copie échoue, tous les originaux restent en place."
          }
        }
      }
    },
    "transfer.namesNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing items are kept. A numbered name is used when needed. Incomplete copies are kept for inspection; Oust! does not remove them automatically. On exFAT/FAT, single files are kept inside a folder of the same name to preserve their metadata companions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments existants sont conservés. Un nom numéroté est utilisé au besoin. Les copies inachevées restent inspectables ; Oust! ne les efface pas automatiquement. Sur exFAT/FAT, un fichier isolé est rangé dans un dossier du même nom pour conserver ses fichiers de métadonnées."
          }
        }
      }
    },
    "transfer.planning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading sources and checking the destination…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture des sources et contrôle de la destination…"
          }
        }
      }
    },
