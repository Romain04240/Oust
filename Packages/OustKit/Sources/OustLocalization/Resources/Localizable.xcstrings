          "stringUnit": {
            "state": "translated",
            "value": "What an app built on Chromium (Slack, Discord, Notion, Teams, VS Code…) keeps in ~/Library/Application Support to load faster: web cache, compiled code, graphics shaders. Never its offline data, its settings or your sign-in. Protected while the app is open; browsers are handled in their own section."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’une application bâtie sur Chromium (Slack, Discord, Notion, Teams, VS Code…) garde dans ~/Library/Application Support pour charger plus vite : cache web, code compilé, shaders graphiques. Jamais ses données hors ligne, ses réglages ni votre connexion. Protégé tant que l’application est ouverte ; les navigateurs ont leur propre section."
          }
        }
      }
    },
