        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À envisager : archiver sur un disque externe. Dernière modification des sources : %@. La copie est vérifiée avant l’envoi de l’original à la corbeille du Mac."
          }
        }
      }
    },
