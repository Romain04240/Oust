        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de réglages de l’application, nommé d’après son identifiant."
          }
        }
      }
    },
    "rule.uninstall.savedState.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to do: macOS recreates it on the next launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à faire : macOS le recrée au prochain lancement."
          }
        }
      }
    },
    "rule.uninstall.savedState.title": {
      "extractionState": "manual",
      "localizations": {
