    "transfer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to an external disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer vers un disque externe"
          }
        }
      }
    },
    "transfer.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files or folders, review the plan, then confirm. Every copy is checked with SHA-256 before any original goes to the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des fichiers ou dossiers, vérifiez le plan, puis confirmez. Chaque copie est vérifiée par SHA-256 avant d’envoyer un original à la corbeille du Mac."
          }
        }
      }
    },
    "transfer.chooseSources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files or folders…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir des fichiers ou dossiers…"
          }
        }
      }
    },
    "transfer.chooseDestination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an external folder…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un dossier externe…"
          }
        }
      }
