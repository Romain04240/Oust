          "stringUnit": {
            "state": "translated",
            "value": "What the app keeps in Application Support: settings, libraries, sometimes your documents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’application garde dans Application Support : réglages, bibliothèques, parfois vos documents."
