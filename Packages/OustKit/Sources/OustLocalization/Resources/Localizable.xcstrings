    "similar.never_checked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These images look alike; they aren’t identical. Nothing is checked for you: the star only suggests the best (the largest, then the original), and the last image of a group always stays."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces images se ressemblent sans être identiques. Rien n’est coché à votre place : l’étoile suggère seulement la meilleure (la plus grande, puis l’originale), et la dernière image d’un groupe reste toujours."
          }
        }
      }
    },
