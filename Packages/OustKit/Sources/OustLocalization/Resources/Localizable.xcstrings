    "storage.details.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the gap between occupied space and the file categories in the last scan. It can include macOS volumes, filesystem overhead and data the scan could not read. It is not a list of files to delete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est l’écart entre l’espace occupé et les catégories de fichiers de la dernière analyse. Il peut comprendre les volumes de macOS, la gestion du système de fichiers et des données que l’analyse n’a pas pu lire. Ce n’est pas une liste de fichiers à supprimer."
          }
        }
      }
    },
    "storage.details.occupied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Occupied, excluding purgeable space"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Occupé, hors espace purgeable"
          }
        }
      }
    },
    "storage.details.classified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attributed to file categories in the chart"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribué aux catégories de la jauge"
          }
        }
      }
    },
    "storage.details.remainder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System and unattributed remainder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste Système et non attribué"
          }
        }
      }
    },
    "storage.details.volumes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other volumes sharing this disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres volumes sur ce disque"
          }
        }
      }
    },
    "storage.details.volumes_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live APFS measurements. These volumes help explain disk usage, but do not form a breakdown of the remainder above. They must not be added to it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesures APFS actuelles. Ces volumes aident à comprendre l’occupation du disque, mais ne constituent pas une décomposition du reste ci-dessus. Il ne faut pas les y additionner."
          }
        }
      }
    },
    "storage.details.metadata": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container overhead and metadata"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestion et métadonnées du conteneur"
          }
        }
      }
    },
    "storage.details.apfs_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The APFS volume detail is not available for this disk. No size has been estimated in its place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le détail des volumes APFS n’est pas disponible pour ce disque. Aucune taille n’a été estimée à sa place."
          }
        }
      }
    },
    "storage.details.snapshots": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained by local Time Machine snapshots"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenu par les snapshots Time Machine locaux"
          }
        }
      }
    },
    "storage.details.snapshots_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate APFS measurement. Snapshot space can already be included in purgeable space or volume usage; it is not added to the remainder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mesure APFS séparée. Cet espace peut déjà figurer dans le purgeable ou dans l’occupation du volume ; il n’est pas ajouté au reste."
          }
        }
      }
    },
    "storage.details.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the scan could not read"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’analyse n’a pas pu lire"
          }
        }
      }
    },
    "storage.details.no_unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No unreadable folders were reported in the last scan. Filesystem metadata and other APFS volumes are still outside file categorization."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier illisible n’a été signalé dans la dernière analyse. Les métadonnées et les autres volumes APFS restent hors du classement des fichiers."
          }
        }
      }
    },
    "storage.details.unreadable_count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
