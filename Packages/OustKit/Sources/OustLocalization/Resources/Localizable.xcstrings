    "rule.orphan.launchAgent.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A launchd agent whose program lived inside an app that is no longer on this Mac: it fails at every login. Only its file goes to the Mac’s Trash; it stays loaded until you next log in, with nothing left to launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent launchd dont le programme vivait dans une application qui n’est plus sur ce Mac : il échoue à chaque ouverture de session. Seul son fichier part dans la corbeille du Mac ; il reste chargé jusqu’à la prochaine ouverture de session, sans plus rien à lancer."
          }
        }
      }
    },
    "rule.orphan.logs.back": {
      "extractionState": "manual",
      "localizations": {
