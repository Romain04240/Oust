    },
    "rule.uninstall.webKit.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only from the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement depuis la corbeille du Mac."
          }
        }
      }
    },
    "rule.uninstall.webKit.title": {
      "extractionState": "manual",
      "localizations": {
