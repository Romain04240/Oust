    },
    "rule.version.jdk_gradle.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle downloads it again when a build asks for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle le retélécharge quand une compilation le demande."
          }
        }
      }
    },
    "rule.version.jdk_gradle.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JDK downloaded by Gradle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JDK téléchargé par Gradle"
          }
        }
      }
    },
    "rule.version.jdk_gradle.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Java runtime that Gradle downloaded for a toolchain (~/.gradle/jdks), or the archive it came from."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un environnement Java que Gradle a téléchargé pour une toolchain (~/.gradle/jdks), ou l’archive d’où il vient."
          }
        }
      }
    },
    "rule.version.jdk_system.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing it takes an administrator password, which Oust! doesn’t ask for: drag it to the Mac’s Trash in the Finder if you no longer need it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retirer demande un mot de passe administrateur, qu’Oust! ne demande pas : glissez-le dans la corbeille du Mac depuis le Finder s’il ne vous sert plus."
          }
        }
      }
    },
    "rule.version.jdk_system.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed JDK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JDK installé"
          }
        }
      }
    },
    "rule.version.jdk_system.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Java runtime installed for the whole Mac (/Library/Java/JavaVirtualMachines). The default one (java_home) is always kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un environnement Java installé pour tout le Mac (/Library/Java/JavaVirtualMachines). Celui par défaut (java_home) est toujours gardé."
          }
        }
      }
    },
    "rule.version.macos_installer.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded again from the App Store or Software Update. Keep it if you make bootable installers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À retélécharger depuis l’App Store ou Mise à jour de logiciels. Gardez-le si vous préparez des clés d’installation."
          }
        }
      }
    },
    "rule.version.macos_installer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS installer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeur de macOS"
          }
        }
      }
    },
    "rule.version.macos_installer.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full macOS installer left in Applications after an update or a download."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un installeur complet de macOS resté dans Applications après une mise à jour ou un téléchargement."
          }
        }
      }
    },
    "rule.version.ndk.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded again by Android Studio’s SDK Manager, or by Gradle when a project sets ndkVersion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retéléchargé par le SDK Manager d’Android Studio, ou par Gradle quand un projet fixe ndkVersion."
          }
        }
      }
    },
    "rule.version.ndk.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android NDK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NDK Android"
          }
        }
      }
    },
    "rule.version.ndk.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Android NDK version other than the most recent one, often several gigabytes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version du NDK Android autre que la plus récente, souvent plusieurs gigaoctets."
          }
        }
      }
    },
    "rule.version.nvm.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalled with nvm install; then reinstall its global packages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se réinstalle par nvm install ; réinstallez ensuite ses paquets globaux."
          }
        }
      }
    },
    "rule.version.nvm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node version (nvm)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de Node (nvm)"
          }
        }
      }
    },
    "rule.version.nvm.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Node.js version installed with nvm that isn’t your default one (nvm alias default). The global packages installed with it go with it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version de Node.js installée par nvm qui n’est pas celle par défaut (nvm alias default). Les paquets globaux installés avec elle partent avec elle."
          }
        }
      }
    },
    "rule.version.pyenv.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalled with pyenv install, which compiles Python again (a few minutes)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se réinstalle par pyenv install, qui recompile Python (quelques minutes)."
          }
        }
      }
    },
    "rule.version.pyenv.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Python version (pyenv)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de Python (pyenv)"
          }
        }
      }
    },
    "rule.version.pyenv.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Python version installed with pyenv that isn’t the global one (pyenv global). Removed with pyenv uninstall, along with its virtual environments if it has any."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version de Python installée par pyenv qui n’est pas la globale (pyenv global). Retirée par pyenv uninstall, avec ses environnements virtuels s’il y en a."
          }
        }
      }
    },
    "rule.version.rustup.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalled with rustup toolchain install."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se réinstalle par rustup toolchain install."
          }
        }
      }
    },
    "rule.version.rustup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust toolchain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolchain Rust"
          }
        }
      }
    },
    "rule.version.rustup.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Rust toolchain installed with rustup other than the default one (rustup default). Removed with rustup toolchain uninstall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une toolchain Rust installée par rustup autre que celle par défaut (rustup default). Retirée par rustup toolchain uninstall."
          }
        }
      }
    },
    "rule.version.xcode.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded again from the App Store or developer.apple.com. Keep it if a project still needs its SDK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À retélécharger depuis l’App Store ou developer.apple.com. Gardez-le si un projet a encore besoin de son SDK."
          }
        }
      }
    },
    "rule.version.xcode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another copy of Xcode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autre exemplaire d’Xcode"
          }
        }
      }
    },
    "rule.version.xcode.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of Xcode other than the one chosen with xcode-select, which the command line and builds use. Betas and older versions pile up at 10 GB or more each."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un exemplaire d’Xcode autre que celui choisi par xcode-select, qu’utilisent la ligne de commande et les compilations. Bêtas et anciennes versions s’empilent, à 10 Go ou plus chacune."
          }
        }
      }
    },
    "rule.vm.docker.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Managed by Docker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géré par Docker."
          }
        }
      }
    },
    "rule.vm.docker.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker disk image"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image disque Docker"
          }
        }
      }
    },
    "rule.vm.docker.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Desktop’s virtual disk. Shrink it from Docker (docker system prune) rather than deleting it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque virtuel de Docker Desktop. À réduire depuis Docker (docker system prune) plutôt qu’à supprimer."
          }
        }
      }
    },
    "rule.vm.image.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas."
          }
        }
      }
    },
    "rule.vm.image.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual machine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Machine virtuelle"
          }
        }
      }
    },
    "rule.vm.image.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete virtual computer. Better moved to an external SSD than deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordinateur virtuel complet. Mieux vaut la déplacer sur un SSD externe que la supprimer."
          }
        }
      }
    },
    "rule.volume.appledouble.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put back from the Mac’s Trash, next to its file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis la corbeille du Mac, remis à côté de son fichier."
          }
        }
      }
    },
    "rule.volume.appledouble.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS metadata files (._)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées de macOS (._)"
          }
        }
      }
    },
    "rule.volume.appledouble.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a disk that isn’t formatted for the Mac (exFAT, FAT, NTFS), macOS writes a “._name” file next to each file that has metadata: tags, comments, where it came from, custom icon. Invisible on the Mac, they clutter the disk on Windows or a TV, and each takes a whole block. The file itself stays untouched; only its Mac metadata goes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un disque qui n’est pas formaté pour le Mac (exFAT, FAT, NTFS), macOS écrit un fichier « ._nom » à côté de chaque fichier qui a des métadonnées : étiquettes, commentaires, provenance, icône. Invisibles sur le Mac, ils encombrent le disque sous Windows ou sur une télévision, et chacun prend un bloc entier. Le fichier lui-même reste intact ; seules ses métadonnées du Mac partent."
          }
        }
      }
    },
    "rule.volume.appledouble_orphan.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to rebuild."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à reconstruire."
          }
        }
      }
    },
    "rule.volume.appledouble_orphan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orphaned macOS metadata (._)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées orphelines (._)"
          }
        }
      }
    },
    "rule.volume.appledouble_orphan.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“._name” files whose file no longer exists (deleted or renamed on another computer). They describe nothing anymore."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fichiers « ._nom » dont le fichier n’existe plus (supprimé ou renommé sur un autre ordinateur). Ils ne décrivent plus rien."
          }
        }
      }
    },
    "rule.volume.ds_store.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder writes it again the next time it opens the folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder le réécrit en rouvrant le dossier."
          }
        }
      }
    },
    "rule.volume.ds_store.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder view settings (.DS_Store)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages d’affichage du Finder (.DS_Store)"
          }
        }
      }
    },
    "rule.volume.ds_store.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout the Finder leaves in each folder it opens on this disk: icon positions, view, sort order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition que le Finder laisse dans chaque dossier ouvert sur ce disque : place des icônes, présentation, tri."
          }
        }
      }
    },
    "rule.volume.installer.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download it again from its website if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À retélécharger sur son site au besoin."
          }
        }
      }
    },
    "rule.volume.installer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer on this disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeur sur ce disque"
          }
        }
      }
    },
    "rule.volume.installer.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A disk image or installer package stored on this disk. Sometimes kept on purpose, as an archive: check before throwing it away."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image disque ou un paquet d’installation rangé sur ce disque. Parfois gardé exprès, en archive : vérifiez avant de le jeter."
          }
        }
      }
    },
    "rule.volume.photo_library.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas."
          }
        }
      }
    },
    "rule.volume.photo_library.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo library"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photothèque"
          }
        }
      }
    },
    "rule.volume.photo_library.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Photos library stored on this disk. Oust! sorts photos through Photos, which only shows it the system library: to tidy this one, open it in Photos (hold Option while opening Photos) and make it the system library. Here, Oust! shows its size and never removes anything from it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photothèque de Photos rangée sur ce disque. Oust! trie les photos par Photos, qui ne lui montre que la photothèque système : pour ranger celle-ci, ouvrez-la dans Photos (Option au lancement de Photos) et faites-en la photothèque système. Ici, Oust! montre sa taille et n’y retire jamais rien."
          }
        }
      }
    },
    "rule.volume.time_machine.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas."
          }
        }
      }
    },
    "rule.volume.time_machine.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine backup"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde Time Machine"
          }
        }
      }
    },
    "rule.volume.time_machine.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups made by Time Machine. Oust! never touches them: to free space here, remove old backups from Time Machine itself, or let it delete the oldest ones when the disk is full. Oust! doesn’t walk through them: in a Backups.backupdb folder, their size isn’t measured."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes faites par Time Machine. Oust! n’y touche jamais : pour libérer de la place ici, retirez les anciennes sauvegardes depuis Time Machine lui-même, ou laissez-le effacer les plus vieilles quand le disque est plein. Oust! ne les parcourt pas : rangées dans un dossier Backups.backupdb, leur taille n’est pas mesurée."
          }
        }
      }
    },
    "rule.xcode.archive.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back: keep the ones you shipped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas : gardez celles que vous avez publiées."
