    "transfer.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy, verify, then move originals to the Mac’s Trash"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier, vérifier, puis mettre les originaux à la corbeille du Mac"
          }
        }
      }
    },
    "transfer.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This authorizes copying the listed items to the chosen folder and moving their originals to the Mac’s Trash only after every copy has passed SHA-256 verification and a final recheck. Space is not freed until the Mac’s Trash is emptied. Cancellation stops before the next original; items already in the Mac’s Trash remain restorable there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette confirmation autorise la copie des éléments listés dans le dossier choisi, puis la mise à la corbeille du Mac des originaux après vérification SHA-256 de toutes les copies et un dernier contrôle. L’espace ne sera libéré qu’après vidage de la corbeille du Mac. L’annulation arrête avant l’original suivant ; ceux déjà à la corbeille du Mac y restent restaurables."
          }
        }
      }
    },
    "transfer.trashing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving verified originals to the Mac’s Trash…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à la corbeille du Mac des originaux vérifiés…"
          }
        }
      }
    },
    "transfer.verifying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying contents and rechecking originals…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification du contenu et nouveau contrôle des originaux…"
          }
        }
      }
    },
    "transfer.copying": {
      "extractionState": "manual",
      "localizations": {
