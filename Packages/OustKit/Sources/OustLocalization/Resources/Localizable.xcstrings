    "system.attachments_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! needs Full Disk Access to see Mail and Messages. Attachments go to the Mac’s Trash, never the messages themselves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! a besoin de l’Accès complet au disque pour voir Mail et Messages. Les pièces jointes vont à la corbeille du Mac, jamais les messages eux-mêmes."
          }
        }
      }
    },
    "system.cloud_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evicting deletes nothing: the file stays in the cloud, visible in the Finder, and downloads again when you open it. Only what is already uploaded is evicted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évincer ne supprime rien : le fichier reste dans le nuage, visible dans le Finder, et se retélécharge quand vous l’ouvrez. Seul ce qui est déjà envoyé est évincé."
          }
        }
      }
    },
    "system.protected_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown so you know where the space went, never offered: Time Machine manages its backups, and Photos only lets Oust! see the system photo library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montré pour savoir où est passé l’espace, jamais proposé : Time Machine gère ses sauvegardes, et Photos ne laisse voir à Oust! que la photothèque système."
          }
        }
      }
    },
    "system.safari_download_occupied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ occupés"
          }
        }
      }
    },
    "system.safari_download_review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in Safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier dans Safari"
          }
        }
      }
    },
    "system.snapshots_add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throw the snapshots in the bin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre les snapshots à la corbeille"
          }
        }
      }
    },
    "system.snapshots_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine takes a local snapshot every hour and keeps it for 24 hours, even when your backup disk isn’t connected. Each one holds on to the files deleted since — which is why freed space sometimes doesn’t show. Deleting them asks for your password, unless the helper is installed in Settings; your real backups are not affected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine prend un snapshot local toutes les heures et le garde 24 heures, même sans disque de sauvegarde branché. Chacun retient les fichiers supprimés depuis — c’est pourquoi l’espace libéré n’apparaît parfois pas. Les supprimer demande votre mot de passe, sauf si le composant est installé dans les Réglages ; vos vraies sauvegardes ne sont pas touchées."
          }
        }
      }
    },
    "system.snapshots_none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None: Time Machine isn't holding anything on this Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun : Time Machine ne retient rien sur ce Mac."
          }
        }
      }
    },
    "system.snapshots_number": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local snapshots: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots locaux : %@"
          }
        }
      }
    },
    "system.snapshots_size_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS measures each snapshot’s private blocks. The total also includes blocks shared between Time Machine snapshots. If a measurement is unavailable, it stays explicitly marked as unmeasured."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS mesure les blocs privés de chaque snapshot. Le total inclut aussi les blocs partagés entre snapshots Time Machine. Si une mesure n’est pas disponible, elle reste explicitement indiquée comme non mesurée."
          }
        }
      }
    },
    "system.snapshots_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Time Machine snapshots"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots Time Machine locaux"
          }
        }
      }
    },
    "system.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac’s Trash, downloads, app, creative and game caches, attachments, cloud files, backups and virtual machines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbeille du Mac, téléchargements, caches d’applications, de création et de jeux, pièces jointes, fichiers du nuage, sauvegardes et machines virtuelles."
          }
        }
      }
    },
    "system.traces_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS writes these files on disks that aren’t formatted for the Mac. A “._” file whose file still exists holds its metadata (tags, comments, where it came from): it goes to the Mac’s Trash. Without its file, it goes right away, like .DS_Store files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS écrit ces fichiers sur les disques qui ne sont pas formatés pour le Mac. Un fichier « ._ » dont le fichier existe encore porte ses métadonnées (étiquettes, commentaires, provenance) : il va à la corbeille du Mac. Sans son fichier, il part tout de suite, comme les .DS_Store."
          }
        }
      }
    },
    "system.user_log_modified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modified %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifié %@"
          }
        }
      }
    },
    "system.user_logs_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs last modified more than 30 days ago. Oust! displays them for inspection and blocks automatic removal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux modifiés pour la dernière fois il y a plus de 30 jours. Oust! permet de les consulter et bloque leur déplacement."
          }
        }
      }
    },
    "system.vm_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtual machines and Docker images are counted apart: they are tools, not clutter. Move them to an external SSD rather than deleting them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les machines virtuelles et images Docker sont comptées à part : ce sont des outils, pas du désordre. Mieux vaut les déplacer sur un SSD externe que les supprimer."
          }
        }
      }
    },
    "system.vm_volume_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this disk, virtual machines are right where they belong: Oust! shows them without offering them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ce disque, les machines virtuelles sont à leur place : Oust! les montre sans les proposer."
          }
        }
      }
    },
    "system.volume_trash_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you throw away from this disk stays on it until the Mac’s Trash is emptied."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’on jette depuis ce disque y reste tant que la corbeille du Mac n’est pas vidée."
          }
        }
      }
    },
    "trashed.back_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of it is installed again: its files are still in use, nothing to remove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie est de nouveau installée : ses fichiers servent encore, rien à retirer."
          }
        }
      }
    },
    "trashed.back_title": {
      "extractionState": "manual",
