      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage of the web pages shown inside the app. It can hold data you created there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage local des pages web affichées dans l’application. Il peut garder ce que vous y avez créé."
          }
        }
