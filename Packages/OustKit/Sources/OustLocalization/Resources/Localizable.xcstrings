    "orphans.strict_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A leftover is offered only if it carries an app identifier that no installed app, module or helper claims, that macOS knows no copy of, and that nothing has written to lately. When in doubt, it is kept. Caches are already in System › App caches. Everything goes to the Mac’s Trash; a background agent stays loaded until you next log in, with nothing left to launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reste n’est proposé que s’il porte l’identifiant d’une application qu’aucune application, aucun module ni aucun assistant installé ne revendique, dont macOS ne connaît plus aucune copie, et où rien n’a écrit ces derniers jours. Dans le doute, il est gardé. Les caches sont déjà dans Système › Caches d’applications. Tout part dans la corbeille du Mac ; un agent d’arrière-plan reste chargé jusqu’à la prochaine ouverture de session, sans plus rien à lancer."
          }
        }
      }
    },
    "orphans.subtitle": {
