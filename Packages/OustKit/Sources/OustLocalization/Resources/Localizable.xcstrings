    "method.trash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to the Mac’s Trash, restorable from the History."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis dans la corbeille du Mac, restaurable depuis l’Historique."
          }
        }
      }
    },
    "method.trashFromCloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to the Mac’s Trash by the Finder. The service then deletes it in the cloud and on your other devices too; Put Back brings it back until the Mac’s Trash is emptied."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis dans la corbeille du Mac par le Finder. Le service le supprime alors aussi dans le cloud et sur vos autres appareils ; « Remettre » le fait revenir tant que la corbeille du Mac n’est pas vidée."
          }
        }
      }
    },
    "method.uninstallVersion": {
