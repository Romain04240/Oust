      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreadable data has no known size. A new scan or Full Disk Access can improve attribution; macOS may still reserve space that cannot be classified as files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données illisibles n’ont pas de taille connue. Une nouvelle analyse ou l’Accès complet au disque peut améliorer le détail ; macOS peut encore réserver de l’espace qui ne correspond pas à des fichiers classables."
          }
        }
