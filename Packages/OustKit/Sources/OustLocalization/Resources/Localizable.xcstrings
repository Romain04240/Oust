    "advice.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local recommendations based on your project folders and the latest disk analysis. Sizes show what occupies the disk, not guaranteed savings. Nothing is selected or moved automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseils locaux fondés sur vos dossiers de projets et la dernière analyse du disque. Les tailles indiquent l’espace occupé, pas un gain garanti. Rien n’est sélectionné ni déplacé automatiquement."
          }
        }
      }
    },
    "advice.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recommendation with the current criteria. Analyze the disk or add project folders in Archive to look further."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conseil avec les critères actuels. Analysez le disque ou ajoutez des dossiers dans Archivage pour chercher davantage."
          }
        }
      }
    },
