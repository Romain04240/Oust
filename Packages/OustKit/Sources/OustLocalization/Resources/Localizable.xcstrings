    "access.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Full Disk Access, macOS hides Mail, Messages, Safari, the Mac’s Trash and iOS backups from Oust!. Grant it in System Settings, then relaunch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans l’Accès complet au disque, macOS cache à Oust! Mail, Messages, Safari, la corbeille du Mac et les sauvegardes iOS. Accordez-le dans Réglages Système, puis relancez."
          }
        }
      }
    },
    "access.open": {
