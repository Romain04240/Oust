      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An item ID returned by scan, or a rule ID such as cache.npm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un identifiant d’élément rendu par scan, ou un identifiant de règle comme cache.npm."
          }
        }
      }
    },
    "mcp.param.ids": {
      "extractionState": "manual",
