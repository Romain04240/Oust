        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Telegram Desktop"
          }
        }
      }
    },
    "rule.cache.telegram.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files and media that Telegram Desktop downloaded as you scrolled through chats, for each account (tdata/user_data/cache and media_cache): what its “Manage local storage” clears. Not your session or settings. Protected while Telegram is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers et médias que Telegram Desktop a téléchargés en faisant défiler les discussions, compte par compte (tdata/user_data/cache et media_cache) : ce que vide son « Gérer le stockage local ». Ni votre session ni vos réglages. Protégé tant que Telegram est ouvert."
          }
        }
      }
    },
    "rule.cache.yarn.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded again when needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retéléchargé au besoin."
          }
        }
      }
    },
    "rule.cache.yarn.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache Yarn"
          }
        }
      }
    },
    "rule.cache.yarn.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarn’s download cache."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache de téléchargement de Yarn."
          }
        }
      }
    },
    "rule.cloud.file_provider.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. Offline, evicted files are out of reach until you reconnect. A file not yet uploaded, or in conflict, is never evicted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé. Hors connexion, les fichiers évincés sont hors de portée jusqu’au retour du réseau. Un fichier pas encore envoyé, ou en conflit, n’est jamais évincé."
          }
        }
      }
    },
    "rule.cloud.file_provider.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud drive — local copies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disque en ligne — copies locales"
          }
        }
      }
    },
    "rule.cloud.file_provider.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files from Google Drive, Dropbox, OneDrive or another cloud drive that are kept downloaded on this Mac. Oust! removes only the local copy: the file stays in the cloud and downloads again when you open it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fichiers de Google Drive, Dropbox, OneDrive ou d’un autre disque en ligne, gardés téléchargés sur ce Mac. Oust! ne retire que la copie locale : le fichier reste dans le nuage et se retélécharge quand vous l’ouvrez."
          }
        }
      }
    },
    "rule.cloud.icloud.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is deleted. Offline, evicted files are out of reach until you reconnect: keep at hand what you need on the road. A file not yet uploaded is never evicted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est supprimé. Hors connexion, les fichiers évincés sont hors de portée jusqu’au retour du réseau : gardez sous la main ce qu’il vous faut en déplacement. Un fichier pas encore envoyé n’est jamais évincé."
          }
        }
      }
    },
    "rule.cloud.icloud.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive — local copies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive — copies locales"
          }
        }
      }
    },
    "rule.cloud.icloud.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files already stored in iCloud Drive that also take room on this Mac. Oust! removes only the local copy: the file stays in iCloud, visible in the Finder, and downloads again when you open it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fichiers déjà rangés dans iCloud Drive qui occupent aussi ce Mac. Oust! ne retire que la copie locale : le fichier reste dans iCloud, visible dans le Finder, et se retélécharge quand vous l’ouvrez."
          }
        }
      }
    },
    "rule.clouds.file.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving it to the Mac’s Trash deletes it in the cloud and on your other devices too."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mettre à la corbeille du Mac le supprime aussi dans le cloud et sur vos autres appareils."
          }
        }
      }
    },
    "rule.clouds.file.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File in the cloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier du cloud"
          }
        }
      }
    },
    "rule.clouds.file.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file from your cloud, seen through the placeholder the service keeps on this Mac: its name, size and date, without its content being downloaded. Oust! never signs in to your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier de votre cloud, vu par le fichier fantôme que le service garde sur ce Mac : son nom, sa taille et sa date, sans que son contenu soit téléchargé. Oust! ne se connecte jamais à votre compte."
          }
        }
      }
    },
    "rule.compress.project.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content doesn’t change. The gain shown is estimated on a sample; the real figure is measured file by file. Every file is rewritten, so Time Machine backs it up again, and local snapshots keep the old blocks until they expire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu ne change pas. Le gain affiché est estimé sur un échantillon ; le chiffre réel est mesuré fichier par fichier. Chaque fichier est réécrit : Time Machine le sauvegarde à nouveau, et les snapshots locaux gardent les anciens blocs jusqu’à leur expiration."
          }
        }
      }
    },
    "rule.compress.project.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormant project"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projet endormi"
          }
        }
      }
    },
    "rule.compress.project.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project nobody has touched for months. APFS can store its files compressed: they stay in place and open as before, only smaller. Each file is compressed, read back and compared with the original before replacing it; git history, dependencies and build folders are left alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet que personne n’a touché depuis des mois. APFS sait ranger ses fichiers compressés : ils restent à leur place et s’ouvrent comme avant, en plus petit. Chaque fichier est compressé, relu et comparé à l’original avant de le remplacer ; l’historique git, les dépendances et les dossiers de build ne sont pas touchés."
          }
        }
      }
    },
    "rule.container.build_cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt by the next docker build, more slowly the first time. The space is freed inside the engine’s virtual disk, which gives it back to the Mac as it shrinks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit par le prochain docker build, plus lentement la première fois. L’espace se libère dans le disque virtuel du moteur, qui le rend au Mac en se compactant."
          }
        }
      }
    },
    "rule.container.build_cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker build cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de build Docker"
          }
        }
      }
    },
    "rule.container.build_cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layers that Docker or OrbStack keeps to rebuild images faster (docker builder prune)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les couches que Docker ou OrbStack garde pour reconstruire les images plus vite (docker builder prune)."
          }
        }
      }
    },
    "rule.container.images.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulled again with docker pull; an image built on this Mac must be rebuilt with docker build. The space is freed inside the engine’s virtual disk, which gives it back to the Mac as it shrinks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retéléchargées par docker pull ; une image construite sur ce Mac se reconstruit par docker build. L’espace se libère dans le disque virtuel du moteur, qui le rend au Mac en se compactant."
          }
        }
      }
    },
    "rule.container.images.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unused Docker images"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images Docker inutilisées"
          }
        }
      }
    },
    "rule.container.images.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images that no container used at analysis time. Oust! asks Docker to remove exactly those (docker image rm), and Docker refuses any a container has started using since."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images qu’aucun conteneur n’utilisait à l’analyse. Oust! demande à Docker de retirer celles-là (docker image rm), et Docker refuse celles qu’un conteneur s’est mis à utiliser depuis."
          }
        }
      }
    },
    "rule.container.stopped.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back: recreate them with docker run or docker compose up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendront pas : recréez-les par docker run ou docker compose up."
          }
        }
      }
    },
    "rule.container.stopped.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped containers"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteneurs arrêtés"
          }
        }
      }
    },
    "rule.container.stopped.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers that were stopped at analysis time (docker container rm). What was written inside them goes with them; a container restarted since is kept, and volumes are never touched."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conteneurs arrêtés au moment de l’analyse (docker container rm). Ce qui a été écrit dedans part avec eux ; un conteneur redémarré depuis est gardé, et les volumes ne sont jamais touchés."
          }
        }
      }
    },
    "rule.creative.ableton.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live decodes them again the next time a Set uses them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live les décode de nouveau quand un Set s’en sert."
          }
        }
      }
    },
    "rule.creative.ableton.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ableton Live decoding cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de décodage d’Ableton Live"
          }
        }
      }
    },
    "rule.creative.ableton.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed audio files (MP3, AAC…) that Ableton Live decoded so it can play them (~/Library/Caches/Ableton/Cache). Your Sets and recordings are not in there. Protected while Live is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers audio compressés (MP3, AAC…) qu’Ableton Live a décodés pour pouvoir les lire (~/Library/Caches/Ableton/Cache). Vos Sets et vos enregistrements n’y sont pas. Protégé tant que Live est ouvert."
          }
        }
      }
    },
    "rule.creative.adobe.media_cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreated when a project needs it; the first opening of a large project takes longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recréé quand un projet en a besoin ; la première ouverture d’un gros projet est plus longue."
          }
        }
      }
    },
    "rule.creative.adobe.media_cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adobe media cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Media Cache d’Adobe"
          }
        }
      }
    },
    "rule.creative.adobe.media_cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files that Premiere Pro, After Effects and Media Encoder make on import to play your media faster (peak files, conformed audio), and the database linking them to your media (Media Cache Files, Media Cache, in ~/Library/Application Support/Adobe/Common). Your projects and media are not in there. Protected while one of these apps is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que Premiere Pro, After Effects et Media Encoder créent à l’import pour lire vos médias plus vite (fichiers de crêtes, audio conformé), et la base qui les relie à vos médias (Media Cache Files, Media Cache, dans ~/Library/Application Support/Adobe/Common). Vos projets et vos médias n’y sont pas. Protégé tant que l’une de ces applications est ouverte."
          }
        }
      }
    },
    "rule.creative.archicad.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archicad recreates it automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archicad le recrée de lui-même."
          }
        }
      }
    },
    "rule.creative.archicad.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archicad library cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache des bibliothèques d’Archicad"
          }
        }
      }
    },
    "rule.creative.archicad.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library cache and local copies of network libraries that Archicad keeps (~/Library/Caches/Graphisoft). Never your projects or autosaves, kept elsewhere. Protected while Archicad is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache des bibliothèques et les copies locales des bibliothèques réseau que garde Archicad (~/Library/Caches/Graphisoft). Jamais vos projets ni vos sauvegardes automatiques, rangés ailleurs. Protégé tant qu’Archicad est ouvert."
          }
        }
      }
    },
    "rule.creative.autocad.graphics_cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoCAD recreates it as you open drawings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoCAD le recrée à mesure que vous ouvrez des dessins."
          }
        }
      }
    },
    "rule.creative.autocad.graphics_cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoCAD graphics cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache graphique d’AutoCAD"
          }
        }
      }
    },
    "rule.creative.autocad.graphics_cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphics data that AutoCAD for Mac keeps between drawing sessions (GraphicsCache, in Application Support/Autodesk/local). Your drawings are not in there. Protected while AutoCAD is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données graphiques qu’AutoCAD pour Mac garde d’une séance de dessin à l’autre (GraphicsCache, dans Application Support/Autodesk/local). Vos dessins n’y sont pas. Protégé tant qu’AutoCAD est ouvert."
          }
        }
      }
    },
    "rule.creative.avid.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt at the next launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruits au prochain lancement."
          }
        }
      }
    },
    "rule.creative.avid.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media Composer caches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de Media Composer"
          }
        }
      }
    },
    "rule.creative.avid.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image and source browser caches of Avid Media Composer (/Users/Shared/AvidMediaComposer). Never your media, bins or the Avid Attic backups. Protected while Media Composer is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caches d’images et du navigateur de sources d’Avid Media Composer (/Users/Shared/AvidMediaComposer). Jamais vos médias, vos chutiers ni les sauvegardes d’Avid Attic. Protégés tant que Media Composer est ouvert."
          }
        }
      }
    },
    "rule.creative.blender.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender indexes its libraries again and downloads online assets when you use them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender réindexe ses bibliothèques et retélécharge les assets en ligne quand vous vous en servez."
          }
        }
      }
    },
    "rule.creative.blender.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Blender"
          }
        }
      }
    },
    "rule.creative.blender.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender’s asset library indexes and the online assets it downloaded (~/Library/Caches/Blender). Protected while Blender is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les index des bibliothèques d’assets de Blender et les assets en ligne qu’il a téléchargés (~/Library/Caches/Blender). Protégé tant que Blender est ouvert."
          }
        }
      }
    },
    "rule.creative.blender.temp.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender opens a new one at its next launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender en ouvre un nouveau à son prochain lancement."
          }
        }
      }
    },
    "rule.creative.blender.temp.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blender session files"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de session de Blender"
          }
        }
      }
    },
    "rule.creative.blender.temp.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary folders (blender_…) that each Blender session opens and leaves behind when it closes badly. Not quit.blend nor the autosaves, which let you recover a lost session. Protected while Blender is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers temporaires (blender_…) que chaque séance de Blender ouvre, et laisse derrière elle quand elle se ferme mal. Pas quit.blend ni les sauvegardes automatiques, qui permettent de retrouver une séance perdue. Protégés tant que Blender est ouvert."
          }
        }
      }
    },
    "rule.creative.capcut.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapCut downloads the effects again when a project uses them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CapCut retélécharge les effets quand un projet s’en sert."
          }
        }
      }
    },
    "rule.creative.capcut.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapCut cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de CapCut"
          }
        }
      }
    },
    "rule.creative.capcut.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What CapCut keeps in ~/Movies/CapCut/User Data/Cache: downloaded effects, player cache, images. Not your projects nor the cloud drafts being synced. Protected while CapCut is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que CapCut garde dans ~/Movies/CapCut/User Data/Cache : effets téléchargés, cache du lecteur, images. Ni vos projets ni les brouillons en cours de synchronisation. Protégé tant que CapCut est ouvert."
          }
        }
      }
    },
    "rule.creative.captureone.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt by Capture One as you browse; it takes a while for a large catalog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit par Capture One à mesure que vous parcourez ; c’est long pour un gros catalogue."
          }
        }
      }
    },
    "rule.creative.captureone.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Capture One"
          }
        }
      }
    },
    "rule.creative.captureone.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews, proxies and thumbnails of a Capture One catalog or session (the Cache folder). Capture One says deleting it removes neither images nor adjustments. Never the Settings folders, which hold your edits. Protected while Capture One is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aperçus, proxys et vignettes d’un catalogue ou d’une session Capture One (le dossier Cache). Capture One dit que l’effacer ne retire ni les images ni les réglages. Jamais les dossiers Settings, qui tiennent vos retouches. Protégé tant que Capture One est ouvert."
          }
        }
      }
    },
    "rule.creative.filmora.temp.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmora creates new ones as needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmora en crée d’autres au besoin."
          }
        }
      }
    },
    "rule.creative.filmora.temp.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmora temporary files"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires de Filmora"
          }
        }
      }
    },
    "rule.creative.filmora.temp.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files Filmora left behind: media analysis, streaming playback (ProgramData/Temp). Not its downloaded effects or its settings. Protected while Filmora is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers temporaires que Filmora a laissés : analyse des médias, lecture en flux (ProgramData/Temp). Ni ses effets téléchargés ni ses réglages. Protégés tant que Filmora est ouvert."
          }
        }
      }
    },
    "rule.creative.godot.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt by Godot as you use it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit par Godot à l’usage."
          }
        }
      }
    },
    "rule.creative.godot.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Godot editor cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de l’éditeur Godot"
          }
        }
      }
    },
    "rule.creative.godot.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnails and other data that the Godot editor keeps (~/Library/Caches/Godot). Godot says it can be removed while Godot is closed. Not your projects, settings or export templates. Protected while Godot is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes et autres données que garde l’éditeur Godot (~/Library/Caches/Godot). Godot le dit supprimable quand il est fermé. Ni vos projets, ni vos réglages, ni les modèles d’export. Protégé tant que Godot est ouvert."
          }
        }
      }
    },
    "rule.creative.indesign.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "InDesign recreates them as needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "InDesign les recrée au besoin."
          }
        }
      }
    },
    "rule.creative.indesign.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "InDesign cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache d’InDesign"
          }
        }
      }
    },
    "rule.creative.indesign.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files that InDesign keeps and Adobe says it can regenerate (~/Library/Caches/Adobe InDesign). Never the InDesign Recovery folder, which can restore unsaved work. Protected while InDesign is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers temporaires qu’InDesign garde et qu’Adobe dit régénérables (~/Library/Caches/Adobe InDesign). Jamais le dossier InDesign Recovery, qui permet de retrouver un travail non enregistré. Protégé tant qu’InDesign est ouvert."
          }
        }
      }
    },
    "rule.creative.insta360.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt by Studio as you use it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruits par Studio à l’usage."
          }
        }
      }
    },
    "rule.creative.insta360.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insta360 Studio caches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches d’Insta360 Studio"
          }
        }
      }
    },
    "rule.creative.insta360.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Insta360 Studio keeps to start faster and preview your edits: its interface and browser caches and its editing preview. Not the cloud export queue next to them. Protected while Studio is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’Insta360 Studio garde pour démarrer plus vite et prévisualiser le montage : caches de son interface et de son navigateur, aperçu du montage. Pas la file des exports dans le nuage, juste à côté. Protégés tant que Studio est ouvert."
          }
        }
      }
    },
    "rule.creative.insta360.proxy.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio makes them again when you reopen the footage; the first preview is slower."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio les refait quand vous rouvrez les rushes ; le premier aperçu est plus lent."
          }
        }
      }
    },
    "rule.creative.insta360.proxy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insta360 Studio proxies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxys d’Insta360 Studio"
          }
        }
      }
    },
    "rule.creative.insta360.proxy.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-resolution copies that Insta360 Studio makes of your 360° footage to preview it smoothly (proxy_file). Your footage stays where it is. Protected while Studio is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies basse définition qu’Insta360 Studio fait de vos rushes à 360° pour les prévisualiser sans à-coups (proxy_file). Vos rushes restent où ils sont. Protégées tant que Studio est ouvert."
          }
        }
      }
    },
    "rule.creative.library.render.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendered again in the background or at export; playback may stutter until then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recalculés en tâche de fond ou à l’export ; la lecture peut saccader d’ici là."
          }
        }
      }
    },
    "rule.creative.library.render.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render files"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de rendu"
          }
        }
      }
    },
    "rule.creative.library.render.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Final Cut Pro or iMovie calculated to play effects, titles and transitions smoothly, kept in each event of the library (Render Files). The library, its projects and its original media are never touched; nothing is offered while either app is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Final Cut Pro ou iMovie a calculé pour lire sans à-coups effets, titres et transitions, rangé dans chaque événement de la bibliothèque (Render Files). La bibliothèque, ses projets et ses médias d’origine ne sont jamais touchés ; rien n’est proposé tant que l’une des deux applications est ouverte."
          }
        }
      }
    },
    "rule.creative.library.transcoded.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the original media is still there, the app can transcode it again. Otherwise:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les médias d’origine sont toujours là, l’application peut les transcoder de nouveau. Sinon :"
          }
        }
      }
    },
    "rule.creative.library.transcoded.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimized and proxy media"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Médias optimisés et proxys"
          }
        }
      }
    },
    "rule.creative.library.transcoded.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies of your clips that Final Cut Pro or iMovie made in a format easier to edit (Transcoded Media). If the originals are gone or on a disconnected drive, they are the only playable copy of those clips: check before ticking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies de vos plans que Final Cut Pro ou iMovie a faites dans un format plus facile à monter (Transcoded Media). Si les originaux ont disparu ou sont sur un disque débranché, ce sont les seules copies lisibles de ces plans : vérifiez avant de cocher."
          }
        }
      }
    },
    "rule.creative.lightroom.previews.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt for each folder or collection you open; the first opening is slower."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refaits pour chaque dossier ou collection que vous ouvrez ; la première ouverture est plus lente."
          }
        }
      }
    },
    "rule.creative.lightroom.previews.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightroom Classic previews"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçus de Lightroom Classic"
          }
        }
      }
    },
    "rule.creative.lightroom.previews.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnails, standard and 1:1 previews of a catalog (“Catalog Previews.lrdata”, next to the .lrcat). Never the Smart Previews, which may be the only editable copy when your originals are offline, nor the catalog itself. Protected while the catalog is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes, aperçus standard et 1:1 d’un catalogue (« Catalogue Previews.lrdata », à côté du .lrcat). Jamais les aperçus dynamiques (Smart Previews), qui peuvent être la seule copie retouchable quand vos originaux sont hors ligne, ni le catalogue lui-même. Protégé tant que le catalogue est ouvert."
          }
        }
      }
    },
    "rule.creative.maxon.assetcache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinema 4D downloads them again from the Asset Browser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinema 4D les retélécharge depuis l’Asset Browser."
          }
        }
      }
    },
    "rule.creative.maxon.assetcache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinema 4D downloaded assets"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assets téléchargés de Cinema 4D"
          }
        }
      }
    },
    "rule.creative.maxon.assetcache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Objects and materials downloaded from the Maxon Asset Browser (Maxon/_assetcache). Scenes that use them may need them again: check before ticking. Protected while Cinema 4D is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objets et matériaux téléchargés depuis l’Asset Browser de Maxon (Maxon/_assetcache). Les scènes qui s’en servent peuvent les redemander : vérifiez avant de cocher. Protégés tant que Cinema 4D est ouvert."
          }
        }
      }
    },
    "rule.creative.plex.updates.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plex downloads the next update itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plex télécharge lui-même la prochaine mise à jour."
          }
        }
      }
    },
    "rule.creative.plex.updates.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plex Media Server updates"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour de Plex Media Server"
          }
        }
      }
    },
    "rule.creative.plex.updates.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages of the Plex Media Server updates that are already installed, kept afterwards (Updates). An update newer than the installed version is waiting to be applied and is left alone. Protected while the server is running."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets des mises à jour de Plex Media Server déjà installées, gardés après coup (Updates). Une mise à jour plus récente que la version installée attend d’être appliquée : elle est laissée de côté. Protégé tant que le serveur tourne."
          }
        }
      }
    },
    "rule.creative.protools.wavecache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Tools recreates it at its next launch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Tools le recrée à son prochain lancement."
          }
        }
      }
    },
    "rule.creative.protools.wavecache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Tools waveform cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache des formes d’onde de Pro Tools"
          }
        }
      }
    },
    "rule.creative.protools.wavecache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The waveforms Pro Tools has drawn for your audio files (/Users/Shared/Pro Tools/WaveCache.wfm). Not the workspace database next to it, which keeps your catalogs. Protected while Pro Tools is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formes d’onde que Pro Tools a dessinées pour vos fichiers audio (/Users/Shared/Pro Tools/WaveCache.wfm). Pas la base de l’espace de travail, à côté, qui garde vos catalogues. Protégé tant que Pro Tools est ouvert."
          }
        }
      }
    },
    "rule.creative.redshift.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next render is slower while Redshift converts them again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain rendu est plus lent, le temps que Redshift les reconvertisse."
          }
        }
      }
    },
    "rule.creative.redshift.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redshift caches"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de Redshift"
          }
        }
      }
    },
    "rule.creative.redshift.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaders and textures that the Redshift renderer converted for your scenes (in Cinema 4D’s preferences, ~/redshift/cache and Application Support/Redshift/TextureCache). Protected while Cinema 4D or a render is running."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les shaders et les textures que le moteur de rendu Redshift a convertis pour vos scènes (dans les préférences de Cinema 4D, ~/redshift/cache et Application Support/Redshift/TextureCache). Protégés tant que Cinema 4D ou un rendu tourne."
          }
        }
      }
    },
    "rule.creative.resolve.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve renders it again as you work; playback may stutter until then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve le recalcule à mesure que vous travaillez ; la lecture peut saccader d’ici là."
          }
        }
      }
    },
    "rule.creative.resolve.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DaVinci Resolve render cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de rendu de DaVinci Resolve"
          }
        }
      }
    },
    "rule.creative.resolve.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What DaVinci Resolve renders ahead of time to play grades and effects in real time, and its audio waveforms (CacheClip, in ~/Movies/DaVinci Resolve). Protected while Resolve is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que DaVinci Resolve calcule d’avance pour lire étalonnage et effets en temps réel, et ses formes d’onde audio (CacheClip, dans ~/Movies/DaVinci Resolve). Protégé tant que Resolve est ouvert."
          }
        }
      }
    },
    "rule.creative.resolve.gallery.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grades in your projects stay; only these stills leave the Gallery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étalonnages de vos projets restent ; seules ces images quittent la Galerie."
          }
        }
      }
    },
    "rule.creative.resolve.gallery.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DaVinci Resolve Gallery stills"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images fixes de la Galerie de DaVinci Resolve"
          }
        }
      }
    },
    "rule.creative.resolve.gallery.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stills you grabbed on DaVinci Resolve’s Color page to compare or reuse a grade (.gallery). You made them yourself: Resolve cannot recreate them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images fixes que vous avez saisies sur la page Étalonnage de DaVinci Resolve pour comparer ou réutiliser un étalonnage (.gallery). Vous les avez faites vous-même : Resolve ne sait pas les recréer."
          }
        }
      }
    },
    "rule.creative.resolve.proxy.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the original media is still there, Resolve can generate them again. Otherwise:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les médias d’origine sont toujours là, Resolve peut les générer de nouveau. Sinon :"
          }
        }
      }
    },
    "rule.creative.resolve.proxy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DaVinci Resolve proxies"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxys de DaVinci Resolve"
          }
        }
      }
    },
    "rule.creative.resolve.proxy.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightweight copies of your clips that DaVinci Resolve generated for smooth editing (ProxyMedia). If the originals are gone or on a disconnected drive, they may be all that is left to play: check before ticking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies allégées de vos plans que DaVinci Resolve a générées pour un montage fluide (ProxyMedia). Si les originaux ont disparu ou sont sur un disque débranché, c’est peut-être tout ce qui reste à lire : vérifiez avant de cocher."
          }
        }
      }
    },
    "rule.creative.sound_library.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing it takes an administrator password, which Oust! doesn’t ask for: drag these folders to the Mac’s Trash in the Finder if you no longer make music. GarageBand offers to download the sounds again (GarageBand › Sound Library)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La retirer demande un mot de passe administrateur, qu’Oust! ne demande pas : glissez ces dossiers dans la corbeille du Mac depuis le Finder si vous ne faites plus de musique. GarageBand propose de retélécharger les sons (GarageBand › Bibliothèque de sons)."
          }
        }
      }
    },
    "rule.creative.sound_library.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GarageBand and Logic Pro sound library"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèque de sons de GarageBand et Logic Pro"
          }
        }
      }
    },
    "rule.creative.sound_library.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruments, loops and lessons that GarageBand and Logic Pro downloaded for the whole Mac: /Library/Application Support/GarageBand and Logic, /Library/Audio/Apple Loops/Apple. Your songs are not in there, but projects that use these sounds will ask for them again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruments, boucles et leçons que GarageBand et Logic Pro ont téléchargés pour tout le Mac : /Library/Application Support/GarageBand et Logic, /Library/Audio/Apple Loops/Apple. Vos morceaux n’y sont pas, mais les projets qui utilisent ces sons les redemanderont."
          }
        }
      }
    },
    "rule.creative.unity.asset_store.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded again from your Asset Store purchases, as long as they are still offered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retéléchargés depuis vos achats de l’Asset Store, tant qu’ils sont encore proposés."
          }
        }
      }
    },
    "rule.creative.unity.asset_store.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unity Asset Store downloads"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargements de l’Asset Store de Unity"
          }
        }
      }
    },
    "rule.creative.unity.asset_store.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Packages downloaded from the Unity Asset Store before importing them into a project (~/Library/Unity/Asset Store-5.x). Projects that imported them keep their own copy. Protected while Unity is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets téléchargés depuis l’Asset Store de Unity avant de les importer dans un projet (~/Library/Unity/Asset Store-5.x). Les projets qui les ont importés en gardent leur copie. Protégés tant que Unity est ouvert."
          }
        }
      }
    },
    "rule.creative.unity.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unity downloads the packages a project needs when you open it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unity retélécharge les paquets qu’un projet demande à son ouverture."
          }
        }
      }
    },
    "rule.creative.unity.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unity package cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache des paquets de Unity"
          }
        }
      }
    },
    "rule.creative.unity.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The packages and metadata that the Unity Package Manager keeps for all your projects (~/Library/Caches/Unity/upm). Your projects are not in there. Protected while Unity is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets et métadonnées que le gestionnaire de paquets de Unity garde pour tous vos projets (~/Library/Caches/Unity/upm). Vos projets n’y sont pas. Protégé tant que Unity est ouvert."
          }
        }
      }
    },
    "rule.creative.unreal.ddc.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed again when a project needs it; the first opening is longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recalculé quand un projet en a besoin ; la première ouverture est plus longue."
          }
        }
      }
    },
    "rule.creative.unreal.ddc.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreal Engine derived data cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de données dérivées d’Unreal Engine"
          }
        }
      }
    },
    "rule.creative.unreal.ddc.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaders, textures and other data that Unreal Engine 5 computed from your assets (Epic/UnrealEngine/Common/Zen/Data). Epic calls it disposable. Your projects are not in there. Protected while the editor or its Zen server is running."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les shaders, textures et autres données qu’Unreal Engine 5 a calculés à partir de vos assets (Epic/UnrealEngine/Common/Zen/Data). Epic le dit jetable. Vos projets n’y sont pas. Protégé tant que l’éditeur ou son serveur Zen tourne."
          }
        }
      }
    },
    "rule.downloads.installer.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download it again from its website if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À retélécharger sur son site au besoin."
          }
        }
      }
    },
    "rule.downloads.installer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeur"
          }
        }
      }
    },
    "rule.downloads.installer.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A disk image or package left in Downloads — usually already installed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image disque ou un paquet resté dans Téléchargements — en général déjà installé."
          }
        }
      }
    },
    "rule.downloads.large.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back once the Mac’s Trash is emptied."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas une fois la corbeille du Mac vidée."
          }
        }
      }
    },
    "rule.downloads.large.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large old download"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gros téléchargement ancien"
          }
        }
      }
    },
    "rule.downloads.large.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large file in Downloads you haven’t touched in over a month."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gros fichier des Téléchargements que vous n’avez pas touché depuis plus d’un mois."
          }
        }
      }
    },
    "rule.downloads.safari_incomplete.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari’s downloads list to see whether you can resume it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la liste des téléchargements de Safari pour voir si vous pouvez le reprendre."
          }
        }
      }
    },
    "rule.downloads.safari_incomplete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incomplete Safari download"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement Safari incomplet"
          }
        }
      }
    },
    "rule.downloads.safari_incomplete.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari uses this kind of package for downloads in progress or interrupted. Oust shows it for inspection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari utilise ce type de paquet pour les téléchargements en cours ou interrompus. Oust l’affiche pour vérification."
          }
        }
      }
    },
    "rule.duplicate.copy.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original stays; restore the copy from the History if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’original reste ; la copie se restaure depuis l’Historique au besoin."
          }
        }
      }
    },
    "rule.duplicate.copy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate copy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie en double"
          }
        }
      }
    },
    "rule.duplicate.copy.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An identical copy, byte for byte, of a file kept elsewhere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie identique, octet pour octet, d’un fichier gardé ailleurs."
          }
        }
      }
    },
    "rule.duplicate.similar.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes to the Mac’s Trash; restore it from there or from the History if needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle part dans la corbeille du Mac ; elle se restaure de là ou depuis l’Historique au besoin."
          }
        }
      }
    },
    "rule.duplicate.similar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar image"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image similaire"
          }
        }
      }
    },
    "rule.duplicate.similar.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An image that looks like others in your folders — the same photo cropped, resized, retouched or exported again, or a shot from the same burst. Vision compares them on this Mac. They aren’t identical: only you can choose which to keep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image qui ressemble à d’autres de vos dossiers — la même photo recadrée, réduite, retouchée ou exportée à nouveau, ou une prise de la même rafale. Vision les compare sur ce Mac. Elles ne sont pas identiques : à vous de choisir lesquelles garder."
          }
        }
      }
    },
    "rule.explorer.item.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes to the Mac’s Trash: restorable until it is emptied."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part dans la corbeille du Mac : restaurable tant qu’elle n’est pas vidée."
          }
        }
      }
    },
    "rule.explorer.item.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Item from the Explorer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élément de l’Explorateur"
          }
        }
      }
    },
    "rule.explorer.item.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file or folder you picked in the Explorer. Oust! knows nothing more about it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier ou dossier choisi dans l’Explorateur. Oust! n’en sait pas plus."
          }
        }
      }
    },
    "rule.game.battlenet.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battle.net downloads what it needs again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Battle.net retélécharge ce qu’il lui faut."
          }
        }
      }
    },
    "rule.game.battlenet.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battle.net cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Battle.net"
          }
        }
      }
    },
    "rule.game.battlenet.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Blizzard calls “Battle.net cache data” (/Users/Shared/Blizzard). Not the Battle.net Agent folder, whose removal makes the app forget where your games are. Protected while Battle.net is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Blizzard appelle les « données en cache de Battle.net » (/Users/Shared/Blizzard). Pas le dossier Agent de Battle.net, dont la suppression fait oublier à l’application où sont vos jeux. Protégé tant que Battle.net est ouvert."
          }
        }
      }
    },
    "rule.game.epic.download.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The launcher starts the download again from the beginning the next time you install or update the game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lanceur reprend le téléchargement depuis le début la prochaine fois que vous installez ou mettez à jour le jeu."
          }
        }
      }
    },
    "rule.game.epic.download.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished Epic download"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement Epic inachevé"
          }
        }
      }
    },
    "rule.game.epic.download.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files Epic Games Launcher prepared to install or update a game (.egstore/bps in the game’s folder) but never finished putting in place: the launcher deletes this folder once the game is ready. Protected while the launcher is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers qu’Epic Games Launcher a préparés pour installer ou mettre à jour un jeu (.egstore/bps dans le dossier du jeu) sans finir de les mettre en place : le lanceur efface ce dossier une fois le jeu prêt. Protégé tant que le lanceur est ouvert."
          }
        }
      }
    },
    "rule.game.epic.leftover.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalling the game from the launcher downloads it again; what you kept in this folder only comes back from the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstaller le jeu depuis le lanceur le retélécharge ; ce que vous gardiez dans ce dossier ne revient que depuis la corbeille du Mac."
          }
        }
      }
    },
    "rule.game.epic.leftover.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalled Epic game"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeu Epic désinstallé"
          }
        }
      }
    },
    "rule.game.epic.leftover.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game folder that Epic Games Launcher on this Mac no longer points to: what an uninstall left behind, in /Users/Shared/Epic Games or in an Epic Games folder on another disk. Protected if the launcher’s list of installations can’t be read. On another disk, also protected if the folder still holds the launcher’s files (.egstore), or if no game next to it was installed from this Mac: the disk may be used by another computer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier de jeu qu’Epic Games Launcher ne désigne plus sur ce Mac : ce qu’une désinstallation a laissé, dans /Users/Shared/Epic Games ou dans un dossier Epic Games d’un autre disque. Protégé si la liste des installations du lanceur ne se lit pas. Sur un autre disque, protégé aussi s’il garde les fichiers du lanceur (.egstore), ou si aucun jeu à côté de lui n’a été installé depuis ce Mac : le disque sert peut-être à un autre ordinateur."
          }
        }
      }
    },
    "rule.game.epic.vault.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The launcher downloads it again from your library when you add it to a project, as long as it is still offered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lanceur le retélécharge depuis votre bibliothèque quand vous l’ajoutez à un projet, tant qu’il est encore proposé."
          }
        }
      }
    },
    "rule.game.epic.vault.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreal Engine asset pack (Vault)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pack d’assets Unreal Engine (Vault)"
          }
        }
      }
    },
    "rule.game.epic.vault.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An asset pack that Epic Games Launcher downloaded to add to your Unreal projects (/Users/Shared/UnrealEngine/Launcher/VaultCache). Projects that already use it keep their own copy. Protected while the launcher is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pack d’assets qu’Epic Games Launcher a téléchargé pour l’ajouter à vos projets Unreal (/Users/Shared/UnrealEngine/Launcher/VaultCache). Les projets qui l’utilisent déjà en gardent leur propre copie. Protégé tant que le lanceur est ouvert."
          }
        }
      }
    },
    "rule.game.gog.webcache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded again as you browse Galaxy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retéléchargé au fil de la navigation dans Galaxy."
          }
        }
      }
    },
    "rule.game.gog.webcache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GOG Galaxy web cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache web de GOG Galaxy"
          }
        }
      }
    },
    "rule.game.gog.webcache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store and library pages that GOG Galaxy keeps for every user of the Mac (/Users/Shared/GOG.com/Galaxy/WebCache). Protected while Galaxy is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages de la boutique et de la bibliothèque que GOG Galaxy garde pour tous les utilisateurs du Mac (/Users/Shared/GOG.com/Galaxy/WebCache). Protégé tant que Galaxy est ouvert."
          }
        }
      }
    },
    "rule.game.heroic.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heroic downloads them again as you browse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heroic les retélécharge au fil de la navigation."
          }
        }
      }
    },
    "rule.game.heroic.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heroic cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Heroic"
          }
        }
      }
    },
    "rule.game.heroic.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game artwork and store data that Heroic keeps (images-cache, store_cache): what its “Clear Heroic Cache” clears. Never your Epic or GOG sign-in, nor your games and their saves. Protected while Heroic is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les illustrations des jeux et les données des boutiques que garde Heroic (images-cache, store_cache) : ce que vide son « Clear Heroic Cache ». Jamais vos connexions Epic ou GOG, ni vos jeux et leurs sauvegardes. Protégé tant que Heroic est ouvert."
          }
        }
      }
    },
    "rule.game.prism.cache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism downloads them again when an instance needs them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism les retélécharge quand une instance en a besoin."
          }
        }
      }
    },
    "rule.game.prism.cache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prism Launcher cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Prism Launcher"
          }
        }
      }
    },
    "rule.game.prism.cache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads and metadata that Prism Launcher keeps in cache (cache, meta). Never your instances, worlds, accounts or Java runtimes. Protected while Prism Launcher is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements et métadonnées que Prism Launcher garde en cache (cache, meta). Jamais vos instances, vos mondes, vos comptes ni les environnements Java. Protégé tant que Prism Launcher est ouvert."
          }
        }
      }
    },
    "rule.game.roblox.logs.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roblox writes new ones at its next session."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Roblox en écrit d’autres à sa prochaine séance."
          }
        }
      }
    },
    "rule.game.roblox.logs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roblox logs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de Roblox"
          }
        }
      }
    },
    "rule.game.roblox.logs.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logs that Roblox writes at each session (~/Library/Logs/Roblox); Roblox itself says everything in this folder can be deleted. Not your settings nor Roblox Studio’s autosaves. Protected while Roblox is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux que Roblox écrit à chaque séance (~/Library/Logs/Roblox) ; Roblox dit lui-même que tout ce dossier peut être effacé. Ni vos réglages ni les sauvegardes automatiques de Roblox Studio. Protégés tant que Roblox est ouvert."
          }
        }
      }
    },
    "rule.game.steam.appcache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam fetches it again at its next launch, which may take a little longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam le récupère de nouveau à son prochain lancement, un peu plus long."
          }
        }
      }
    },
    "rule.game.steam.appcache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de Steam"
          }
        }
      }
    },
    "rule.game.steam.appcache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Steam keeps about your games and its store: game details, library artwork, web cache (appcache). Protected while Steam is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Steam garde sur vos jeux et sa boutique : fiches des jeux, illustrations de la bibliothèque, cache web (appcache). Protégé tant que Steam est ouvert."
          }
        }
      }
    },
    "rule.game.steam.depotcache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam fetches them again at the next update or verification."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam les récupère de nouveau à la prochaine mise à jour ou vérification."
          }
        }
      }
    },
    "rule.game.steam.depotcache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam download manifests"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manifestes de téléchargement de Steam"
          }
        }
      }
    },
    "rule.game.steam.depotcache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists of the files Steam downloaded for your games, kept to check and update them (depotcache). Protected while Steam is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes des fichiers que Steam a téléchargés pour vos jeux, gardées pour les vérifier et les mettre à jour (depotcache). Protégées tant que Steam est ouvert."
          }
        }
      }
    },
    "rule.game.steam.download.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam starts the download again from the beginning the next time you install or update the game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam reprend le téléchargement depuis le début la prochaine fois que vous installez ou mettez à jour le jeu."
          }
        }
      }
    },
    "rule.game.steam.download.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished Steam download"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement Steam inachevé"
          }
        }
      }
    },
    "rule.game.steam.download.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files Steam received for a game but never finished putting in place (steamapps/downloading and steamapps/temp): a download or an update that was paused, cancelled or interrupted. Steam empties these folders once the game is ready. Protected while Steam is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que Steam a reçus pour un jeu sans finir de les mettre en place (steamapps/downloading et steamapps/temp) : un téléchargement ou une mise à jour en pause, annulé ou interrompu. Steam vide ces dossiers une fois le jeu prêt. Protégé tant que Steam est ouvert."
          }
        }
      }
    },
    "rule.game.steam.leftover.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalling the game from Steam downloads it again; what you had added only comes back from the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstaller le jeu depuis Steam le retélécharge ; ce que vous y aviez ajouté ne revient que depuis la corbeille du Mac."
          }
        }
      }
    },
    "rule.game.steam.leftover.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalled Steam game"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeu Steam désinstallé"
          }
        }
      }
    },
    "rule.game.steam.leftover.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder in steamapps/common that no installed game claims any more: Steam left it behind at uninstall, often with mods, local saves or files you added. Protected if a game manifest can’t be read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier de steamapps/common qu’aucun jeu installé ne réclame plus : Steam l’a laissé à la désinstallation, souvent avec des mods, des sauvegardes locales ou des fichiers ajoutés. Protégé si un manifeste de jeu ne se lit pas."
          }
        }
      }
    },
    "rule.game.steam.shadercache.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compiled again the next time each game starts, which may stutter or load longer at first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recompilés au prochain lancement de chaque jeu, qui peut saccader ou charger plus longtemps au début."
          }
        }
      }
    },
    "rule.game.steam.shadercache.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam shader cache"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de shaders de Steam"
          }
        }
      }
    },
    "rule.game.steam.shadercache.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Graphics shaders compiled for your Mac, game by game (steamapps/shadercache), so that games don’t stutter. One per Steam library on this disk. Protected while Steam is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les shaders graphiques compilés pour votre Mac, jeu par jeu (steamapps/shadercache), pour que les jeux ne saccadent pas. Un par bibliothèque Steam sur ce disque. Protégé tant que Steam est ouvert."
          }
        }
      }
    },
    "rule.ios.backup.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back: make sure iCloud or a newer backup covers this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas : vérifiez qu’iCloud ou une sauvegarde plus récente couvre cet appareil."
          }
        }
      }
    },
    "rule.ios.backup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS backup"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde iOS"
          }
        }
      }
    },
    "rule.ios.backup.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local backup of an iPhone or iPad. The most recent is always kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde locale d’iPhone ou d’iPad. La plus récente est toujours gardée."
          }
        }
      }
    },
    "rule.ios.update.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder downloads it again the next time a device needs it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder la retélécharge la prochaine fois qu’un appareil en a besoin."
          }
        }
      }
    },
    "rule.ios.update.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS update"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour iOS"
          }
        }
      }
    },
    "rule.ios.update.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A software update (.ipsw) downloaded to update or restore an iPhone or iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour logicielle (.ipsw) téléchargée pour mettre à jour ou restaurer un iPhone ou un iPad."
          }
        }
      }
    },
    "rule.largefile.item.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes to the Mac’s Trash: restorable until you empty it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il part dans la corbeille du Mac : restaurable tant qu’elle n’est pas vidée."
          }
        }
      }
    },
    "rule.largefile.item.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large file"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gros fichier"
          }
        }
      }
    },
    "rule.largefile.item.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large file you haven’t opened or changed in a while. Oust! knows nothing more about it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gros fichier que vous n’avez pas ouvert ni modifié depuis un moment. Oust! n’en sait pas plus."
          }
        }
      }
    },
    "logs.user.error.restore_conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log could not be put back. Its recovery path is shown in History."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal n’a pas pu être remis en place. Son chemin de récupération figure dans l’Historique."
          }
