    "cart.browsers.politely": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked to quit as with ⌘Q, never forced: if it refuses, its caches stay. Chromium browsers (Chrome, Brave, Edge, Arc…) reopen their tabs; Safari and Firefox follow their own settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prié de quitter comme par ⌘Q, jamais forcé : s’il refuse, ses caches restent. Les navigateurs Chromium (Chrome, Brave, Edge, Arc…) rouvrent leurs onglets ; Safari et Firefox, selon leurs réglages."
          }
        }
      }
    },
