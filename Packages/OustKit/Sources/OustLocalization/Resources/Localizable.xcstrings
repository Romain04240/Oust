    "rule.photos.video.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the heaviest videos in your Photos library. The size shown is what deleting it frees on this Mac; when iCloud Photos optimizes storage, a video kept in iCloud frees almost nothing here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une des vidéos les plus lourdes de votre photothèque. La taille affichée est ce que sa suppression rend sur ce Mac ; quand Photos iCloud optimise le stockage, une vidéo gardée dans iCloud n’y rend presque rien."
          }
        }
      }
    },
    "rule.screenshots.desktop.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They only come back from the Mac’s Trash: keep the ones you still need."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles ne reviennent que depuis la corbeille du Mac : gardez celles qui vous servent encore."
