    "photos.recently_deleted_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted items spend 30 days in Recently Deleted in Photos, which can recover them. The space only comes back after that, or when you empty Recently Deleted. macOS asks you to confirm before anything is deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimés, les éléments passent 30 jours dans « Supprimés récemment » de Photos, qui peut les récupérer. L’espace ne revient qu’ensuite, ou quand vous videz « Supprimés récemment ». macOS vous demande de confirmer avant toute suppression."
          }
        }
      }
    },
