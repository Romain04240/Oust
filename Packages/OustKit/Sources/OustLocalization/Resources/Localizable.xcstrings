    "feedback.bug": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a bug"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler un bug"
          }
        }
      }
    },
    "feedback.bug_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something doesn't work as it should. The email asks what happened and how to make it happen again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose ne marche pas comme prévu. L’e-mail demande ce qui s’est passé et comment le refaire."
          }
        }
      }
    },
    "feedback.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "—\nTo help, Oust! adds only the following, nothing else:\nOust! version: %1$@ (%2$@)\nmacOS version: %3$@\nMac model: %4$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "—\nPour aider, Oust! ajoute seulement ceci, rien d’autre :\nVersion d’Oust! : %1$@ (%2$@)\nVersion de macOS : %3$@\nModèle du Mac : %4$@"
          }
        }
      }
    },
    "feedback.idea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a feature"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggérer une fonction"
          }
        }
      }
    },
    "feedback.idea_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Oust! should know how to do. The email asks for the idea and what it would help with."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’Oust! devrait savoir faire. L’e-mail demande l’idée et à quoi elle servirait."
          }
        }
      }
    },
    "feedback.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message goes straight to the developer. Oust! opens it in Mail: you read it, then send it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message va directement au développeur. Oust! l’ouvre dans votre messagerie : vous le relisez, puis vous l’envoyez."
          }
        }
      }
    },
