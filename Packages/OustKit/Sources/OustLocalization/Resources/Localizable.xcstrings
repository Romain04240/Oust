    "transfer.spaceNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies use logical sizes. No immediate space saving is promised: originals in the Mac’s Trash and APFS snapshots may still occupy space."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont mesurées en taille logique. Aucun gain immédiat n’est promis : les originaux à la corbeille du Mac et les snapshots APFS peuvent encore occuper de l’espace."
          }
        }
      }
    },
    "transfer.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy verified; original in the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie vérifiée ; original dans la corbeille du Mac."
          }
        }
      }
    },
    "transfer.kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original kept in place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Original conservé en place."
          }
        }
      }
    },
