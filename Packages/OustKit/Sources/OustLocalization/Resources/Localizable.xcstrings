    "settings.maintenance.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a maintenance check regularly"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire l’entretien régulièrement"
          }
        }
      }
    },
    "settings.maintenance.enabled_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! analyzes your Mac in the background and shows what can go without risk. Nothing is removed: you review and confirm in the bin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! analyse le Mac en arrière-plan et montre ce qui peut partir sans risque. Rien n’est supprimé : vous revoyez et confirmez dans la corbeille."
          }
        }
      }
    },
    "settings.maintenance.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what the preselection would check counts: what is safe, and what rebuilds itself and hasn’t been used for %@ days. Never anything to review. It waits while an analysis or a cleanup you started is running. Browser caches count as if the browser were closed: the review offers to quit it, then reopen it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul compte ce que la présélection cocherait : le sûr, et ce qui se reconstruit sans avoir servi depuis %@ jours. Jamais l’« À examiner ». Il attend qu’aucune analyse ni aucun vide lancés par vous ne soient en cours. Les caches des navigateurs comptent navigateur fermé : la revue propose de le fermer, puis de le rouvrir."
          }
        }
      }
    },
    "settings.maintenance.found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to reclaim"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à récupérer"
          }
        }
      }
    },
