    "helper.can": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limited actions: delete local Time Machine snapshots by validated date, or older backups from a verified Time Machine destination, only after your cleanup confirmation in Oust!."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions limitées : supprimer des snapshots Time Machine locaux par date validée, ou d’anciennes sauvegardes d’une destination Time Machine vérifiée, uniquement après votre confirmation de nettoyage dans Oust!."
          }
        }
      }
    },
    "helper.cannot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only accepts Oust! signed by its developer. It cannot run arbitrary commands, delete arbitrary files or touch macOS update snapshots. It stops when idle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il accepte uniquement Oust! signé par son développeur. Il ne peut pas lancer une commande libre, supprimer des fichiers quelconques ou toucher aux snapshots de mise à jour de macOS. Il s’arrête lorsqu’il est inactif."
          }
        }
      }
    },
    "helper.details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the helper can do"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que permet le composant"
          }
        }
      }
    },
    "helper.development_build": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development build: macOS normally accepts an administrator helper only from a notarized app, and may refuse this one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie de développement : macOS n’accepte en principe un composant administrateur que d’une app notarisée, et peut refuser celle-ci."
          }
        }
      }
    },
    "helper.failure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a refusé : %@"
          }
        }
      }
    },
    "helper.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for an administrator password to turn it on. You can remove it here at any time; without it, Oust! works as before."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande le mot de passe d’un administrateur pour l’activer. Vous pouvez le retirer ici à tout moment ; sans lui, Oust! fonctionne comme avant."
          }
        }
      }
    },
    "helper.install": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer…"
          }
        }
      }
    },
    "helper.reinstall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réparer"
          }
        }
      }
    },
    "helper.state.active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved helper responds. Oust! can use it for supported administrator actions without asking for your password again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le composant autorisé répond. Oust! peut l’utiliser pour les actions administrateur prévues sans redemander votre mot de passe."
          }
        }
      }
    },
    "helper.state.awaiting_approval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed, waiting for your approval in System Settings › General › Login Items & Extensions. Until then, Oust! asks for your password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé, en attente de votre accord dans Réglages Système › Général › Ouverture et extensions. D’ici là, Oust! demande votre mot de passe."
          }
        }
      }
    },
    "helper.state.not_installed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not installed: Oust! asks for your password each time it deletes snapshots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non installé : Oust! demande votre mot de passe à chaque suppression de snapshots."
          }
        }
      }
    },
    "helper.state.unresponsive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered, but not responding. Oust! keeps the administrator prompt available. Repair re-registers the component from this app; if the problem persists, reinstall a complete signed copy in Applications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré, mais sans réponse. Oust! conserve l’invite administrateur comme solution de repli. Réparer réenregistre le composant depuis cette app ; si le problème persiste, réinstallez une copie signée complète dans Applications."
          }
        }
      }
    },
    "helper.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots without a password"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
