    "method.photoAsset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted by Photos, after macOS asks you to confirm. It stays 30 days in Recently Deleted, where Photos can recover it; the space comes back after that, or when you empty Recently Deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé par Photos, après la confirmation que demande macOS. Il reste 30 jours dans « Supprimés récemment », d’où Photos peut le récupérer ; l’espace revient ensuite, ou quand vous videz « Supprimés récemment »."
          }
        }
      }
    },
    "method.removeNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted right away: it rebuilds itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé tout de suite : il se reconstruit."
          }
        }
      }
    },
    "method.simulatorDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted with simctl, as Xcode would."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé par simctl, comme le ferait Xcode."
          }
        }
      }
    },
    "method.simulatorRuntime": {
