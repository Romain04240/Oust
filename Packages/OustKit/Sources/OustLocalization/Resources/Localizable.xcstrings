    "transfer.error.noSources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose at least one file or folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins un fichier ou dossier."
          }
        }
      }
    },
    "transfer.error.invalidSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source cannot be safely read: unsupported item, unavailable cloud content, another mounted volume, or read error. Nothing was moved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une source ne peut pas être lue en sécurité : type non pris en charge, contenu du nuage indisponible, autre volume monté ou erreur de lecture. Rien n’a été déplacé."
          }
        }
      }
    },
    "transfer.error.overlappingSources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder or its contents, without overlapping sources."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier ou son contenu, sans sources imbriquées."
          }
        }
      }
    },
    "transfer.error.invalidDestination": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an existing writable folder on an external disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier existant et inscriptible sur un disque externe."
          }
        }
      }
    },
    "transfer.error.externalRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination must be on a local external disk. Internal and network volumes are refused."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination doit être sur un disque externe local. Les volumes internes et réseau sont refusés."
          }
        }
      }
    },
    "transfer.error.destinationChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination changed or became unavailable. Originals were kept. Prepare a new plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination a changé ou n’est plus disponible. Les originaux ont été conservés. Préparez un nouveau plan."
          }
        }
      }
    },
    "transfer.error.protectedSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source is protected or in use. Close the application using it and choose an allowed item."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une source est protégée ou en cours d’utilisation. Fermez l’application qui l’utilise et choisissez un élément autorisé."
          }
        }
      }
    },
    "rule.archive.transfer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified external transfer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacement externe vérifié"
          }
        }
      }
    },
    "rule.archive.transfer.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An explicitly chosen file or folder, copied to a different external volume and verified with SHA-256 before the original goes to the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier ou dossier choisi explicitement, copié sur un autre volume externe et vérifié par SHA-256 avant la mise à la corbeille du Mac de l’original."
          }
        }
      }
    },
    "rule.archive.transfer.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the original from the Mac’s Trash, or copy the verified external copy back. Space stays occupied until the Mac’s Trash is emptied; snapshots can retain blocks longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez l’original depuis la corbeille du Mac, ou recopiez la copie externe vérifiée. L’espace reste occupé jusqu’au vidage de la corbeille du Mac ; les snapshots peuvent retenir les blocs plus longtemps."
          }
        }
      }
    },
    "time_machine.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local snapshots on your startup disk, newest first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les snapshots locaux du disque de démarrage, du plus récent au plus ancien."
          }
        }
      }
    },
    "time_machine.local_snapshots": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local snapshots"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots locaux"
          }
        }
      }
    },
    "helper.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the administrator helper…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification du composant administrateur…"
          }
        }
      }
    },
    "helper.persistence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve the helper once in macOS to let Oust! use its limited administrator actions during later cleanups, including after restarting your Mac. Oust! never stores your password. Full Disk Access is a separate macOS permission; if the helper cannot act, Oust! may still show the administrator prompt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez une fois le composant dans macOS pour qu’Oust! utilise ses actions administrateur limitées lors des prochains vidages, y compris après un redémarrage du Mac. Oust! ne conserve jamais votre mot de passe. L’Accès complet au disque reste une autorisation macOS distincte ; si le composant ne peut pas agir, Oust! peut encore afficher l’invite administrateur."
          }
        }
      }
    },
    "helper.stable_location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a stable installation, keep Oust! in Applications and install or repair its helper from that copy. After replacing the app, repair may be needed; macOS keeps control of approval."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une installation stable, conservez Oust! dans Applications et installez ou réparez son composant depuis cette copie. Après remplacement de l’app, une réparation peut être nécessaire ; macOS reste maître de l’autorisation."
          }
        }
      }
    },
    "helper.diagnostic.incomplete_bundle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy is missing the helper executable or its launch configuration. Install a complete signed copy of Oust! before trying again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque le composant ou sa configuration de lancement dans cette copie. Installez une copie signée complète d’Oust! avant de réessayer."
          }
        }
      }
    },
    "helper.diagnostic.invalid_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded helper configuration does not match Oust!’s fixed service. Replace this copy with a complete signed app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration du composant embarqué ne correspond pas au service fixe d’Oust!. Remplacez cette copie par une app signée complète."
          }
        }
      }
    },
    "helper.diagnostic.invalid_signature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper signature does not match Oust!’s expected developer and identifier. Replace this copy with a complete signed app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature du composant ne correspond pas au développeur et à l’identifiant attendus par Oust!. Remplacez cette copie par une app signée complète."
          }
        }
      }
    },
    "helper.update_deferred": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app’s helper has changed. Repair its installation after all cleanups have finished, including in other copies of Oust! or its command-line tool. Oust! never replaces an approved helper automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le composant de cette copie a changé. Réparez son installation une fois tous les nettoyages terminés, y compris dans les autres copies d’Oust! ou son outil en ligne de commande. Oust! ne remplace jamais automatiquement un composant autorisé."
          }
        }
      }
    },
    "helper.operation_busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cleanup or helper update is in progress. Try again when it has finished."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nettoyage ou une mise à jour du composant est en cours. Réessayez après sa fin."
          }
        }
      }
    },
    "cleaning.completed_count": {
