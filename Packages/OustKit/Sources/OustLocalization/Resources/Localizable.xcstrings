    "advice.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find recommendations"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chercher des conseils"
          }
        }
      }
