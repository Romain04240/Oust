    "storage.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available space includes immediately free space and space macOS can purge. Purgeable space also includes caches and local cloud copies; it is not a measurement of snapshots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace disponible comprend le libre immédiat et ce que macOS peut purger. Le purgeable inclut aussi des caches et des copies locales du nuage ; ce n’est pas une mesure des snapshots."
          }
        }
      }
    },
    "snapshot.error.invalid": {
      "extractionState": "manual",
      "localizations": {
