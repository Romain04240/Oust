    "rule.attachments.mail.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With an IMAP account (iCloud, Gmail…), Mail downloads them again when you open the message. With a POP account, they only come back from the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un compte IMAP (iCloud, Gmail…), Mail les retélécharge quand vous ouvrez le message. Avec un compte POP, elles ne reviennent que depuis la corbeille du Mac."
          }
        }
      }
    },
