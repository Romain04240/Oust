    },
    "rule.photos.utility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful photo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo utile"
          }
        }
      }
    },
    "rule.photos.utility.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo taken to keep a piece of information — a barcode, a document, a receipt, a card, a screen or a label — as Vision recognizes it on this Mac. Make sure you no longer need it: it may be your only copy of a document."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo prise pour garder une information — un code-barres, un document, un ticket, une carte, un écran ou une étiquette —, telle que Vision la reconnaît sur ce Mac. Vérifiez qu’elle ne sert plus : c’est peut-être votre seule copie d’un document."
          }
        }
      }
    },
    "rule.photos.video.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos keeps it 30 days in Recently Deleted. With iCloud Photos, deleting it also removes it from your other devices."
          }
        },
        "fr": {
