    "applications.strict_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A leftover is proposed only if it carries exactly this app’s identifier, its name when no other app has it, or if macOS confirms it belongs to the app. Everything goes to the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reste n’est proposé que s’il porte exactement l’identifiant de l’application, son nom quand aucune autre ne le porte, ou si macOS confirme qu’il lui appartient. Tout part dans la corbeille du Mac."
          }
        }
      }
    },
    "applications.unused_filter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last opened over 6 months ago"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière ouverture il y a plus de 6 mois"
          }
        }
      }
    },
    "applications.unused_filter_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows removable apps with a known last-opened date that were closed at the last scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les applications désinstallables dont la date d’ouverture est connue et qui étaient fermées lors de la dernière analyse."
          }
        }
      }
    },
    "applications.unused_no_matches": {
      "extractionState": "manual",
