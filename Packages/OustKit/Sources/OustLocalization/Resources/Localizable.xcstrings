    "settings.watch.rules_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off until you turn them on. They only take what is safe or rebuilds itself, unused for the chosen time, removed by Oust! without going through the Mac’s Trash. Each item is checked again just before it goes, and written to the History. Nothing to review, nothing personal. A notification tells you what went."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivées tant que vous ne les cochez pas. Elles ne prennent que le sûr et ce qui se reconstruit, inutilisé depuis la durée choisie, supprimé par Oust! sans passer par la corbeille du Mac. Chaque élément est revérifié juste avant de partir, et inscrit à l’historique. Rien à examiner, rien de personnel. Une notification raconte ce qui est parti."
          }
        }
      }
    },
    "settings.watch.rules_section": {
