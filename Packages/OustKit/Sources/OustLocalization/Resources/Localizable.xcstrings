            "value": "Screenshots and screen recordings older than 30 days on the Desktop, or wherever screenshots are saved, grouped by month."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures et enregistrements d’écran de plus de 30 jours sur le Bureau, ou là où elles sont enregistrées, regroupés par mois."
          }
        }
      }
    },
