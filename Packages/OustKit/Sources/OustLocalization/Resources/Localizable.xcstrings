    "orphans.searching": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for leftovers…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des restes…"
          }
        }
      }
