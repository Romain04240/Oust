    "developer.compress_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressing frees space without deleting anything: files stay where they are and open as before. Each one is checked before it replaces the original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresser libère de la place sans rien supprimer : les fichiers restent où ils sont et s’ouvrent comme avant. Chacun est vérifié avant de remplacer l’original."
          }
        }
      }
    },
    "developer.containers_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker and OrbStack clean up after themselves on request: Oust! asks them, after your confirmation. Volumes are never touched. The space is counted apart, as it frees up inside their virtual disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker et OrbStack font leur ménage eux-mêmes, sur demande : Oust! le leur demande, après votre confirmation. Les volumes ne sont jamais touchés. L’espace est compté à part, car il se libère dans leur disque virtuel."
          }
        }
      }
    },
    "developer.empty_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run an analysis to find what your tools and AI agents leave behind: dependencies, builds, simulators, worktrees, histories, models."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une analyse pour trouver ce que laissent vos outils et vos agents IA : dépendances, compilations, simulateurs, worktrees, historiques, modèles."
          }
        }
      }
    },
