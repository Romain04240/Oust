      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application bundle itself, as installed in Applications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet de l’application, tel qu’il est installé dans Applications."
          }
        }
      }
    },
    "rule.uninstall.applicationScripts.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only from the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement depuis la corbeille du Mac."
          }
