    "similar.best_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested to keep: the highest resolution, then the original (the oldest). It checks nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggérée à garder : la plus grande résolution, puis l’originale (la plus ancienne). Elle ne coche rien."
          }
        }
      }
    },
    "similar.catalog_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo app that references an image stored elsewhere would lose it if you threw it away."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app de photo qui référence une image rangée ailleurs la perdrait si vous la jetiez."
          }
        }
      }
    },
    "similar.clone_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares all its storage with another file: throwing it away frees nothing while the other one exists."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage tout son stockage avec un autre fichier : la jeter ne libère rien tant que l’autre existe."
          }
        }
      }
    },
    "similar.clone_tag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone"
          }
        }
      }
    },
    "similar.clones": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groups hidden: their images are APFS clones of other files, and throwing them away would free nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groupes masqués : leurs images sont des clones APFS d’autres fichiers, les jeter ne libérerait rien."
          }
        }
      }
    },
    "similar.clones_one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 group hidden: its images are APFS clones of other files, and throwing them away would free nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 groupe masqué : ses images sont des clones APFS d’autres fichiers, les jeter ne libérerait rien."
          }
        }
      }
    },
    "similar.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same photo cropped, resized, retouched or exported twice, and shots taken in a burst. Vision compares each image only with those in the same folder, taken or modified within minutes of it, or bearing the same name. On many images, it takes a while."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une même photo recadrée, réduite, retouchée ou exportée deux fois, et les rafales. Vision ne compare chaque image qu’à celles du même dossier, prises ou modifiées à quelques minutes d’écart, ou qui portent le même nom. Sur beaucoup d’images, cela prend un moment."
          }
        }
      }
    },
    "similar.dimensions": {
      "extractionState": "manual",
      "localizations": {
