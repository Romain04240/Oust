    "photos.cloud_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of these items are only in iCloud: iCloud Photos optimizes this Mac’s storage. Deleting them frees iCloud space but almost nothing here, so the figure above leaves them out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de ces éléments ne sont que dans iCloud : Photos iCloud optimise le stockage de ce Mac. Les supprimer libère de l’espace iCloud, presque rien ici ; le chiffre ci-dessus ne les compte pas."
          }
        }
      }
    },
