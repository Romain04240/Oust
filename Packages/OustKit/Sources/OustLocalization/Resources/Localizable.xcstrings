    "overview.volume_welcome_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! looks through “%@” the way it does your Mac: project artifacts, editing caches and libraries, installers, the disk’s own Trash, macOS traces; then large files and duplicates. Time Machine backups, photo libraries and virtual machines are shown, never offered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! parcourt « %@ » comme votre Mac : artefacts de projets, caches et bibliothèques de montage, installeurs, corbeille du disque, traces de macOS ; puis gros fichiers et doublons. Sauvegardes Time Machine, photothèques et machines virtuelles sont montrées, jamais proposées."
          }
        }
      }
    },
    "overview.welcome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s clear out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On fait le vide ?"
          }
        }
      }
    },
    "overview.welcome_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! shows what takes up space, explains what can be removed and helps you decide. File analysis stays on your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! montre ce qui prend de la place, explique ce qui peut partir et vous aide à choisir. L’analyse des fichiers reste sur votre Mac."
          }
        }
      }
    },
