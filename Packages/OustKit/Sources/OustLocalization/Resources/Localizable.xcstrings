      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is open. Quit it first: Oust! won’t touch it or its files while it runs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application est ouverte. Quittez-la d’abord : Oust! ne touchera ni à elle ni à ses fichiers tant qu’elle tourne."
          }
        }
      }
