          "stringUnit": {
            "state": "translated",
            "value": "Mac OS étendu : tout est gardé."
          }
        }
      }
    },
    "archive.fs_recommended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS: the best choice, everything is kept as on your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS : le meilleur choix, tout est gardé comme sur votre Mac."
          }
        }
      }
    },
    "archive.fs_warning.exfat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT keeps no permissions or owner, stores extended attributes as “._” files and dates to the hundredth of a second. Your files are safe, their Mac details less so. APFS is recommended."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT ne garde ni droits ni propriétaire, range les attributs étendus dans des fichiers « ._ » et date au centième de seconde. Vos fichiers sont saufs, leurs détails Mac moins. APFS est conseillé."
          }
        }
      }
    },
    "archive.fs_warning.fat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FAT32 has the limits of exFAT, and refuses any file of 4 GB or more. APFS is recommended."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FAT32 a les limites d’exFAT, et refuse tout fichier de 4 Go ou plus. APFS est conseillé."
          }
        }
      }
    },
    "archive.fs_warning.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A network volume: checking reads everything back over the network, and a dropped connection stops the archive (the original stays)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volume réseau : la vérification relit tout à travers le réseau, et une coupure arrête l’archivage (l’original reste)."
          }
        }
      }
    },
    "archive.fs_warning.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! doesn’t know this file system well. Everything is checked, but APFS is recommended."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! connaît mal ce système de fichiers. Tout est vérifié, mais APFS est conseillé."
          }
        }
      }
    },
