    "cleaning.stop_requested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop requested. Operations already started by macOS must finish; remaining items will be left in place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt demandé. Les opérations déjà lancées par macOS doivent se terminer ; les éléments restants seront laissés en place."
          }
        }
      }
    },
    "cleaning.phase.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing cleanup"
          }
        },
        "fr": {
