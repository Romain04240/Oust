    "cart.photos_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask you to confirm deleting the photos. They then spend 30 days in Recently Deleted in Photos: the space comes back after that, or when you empty it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vous demandera de confirmer la suppression des photos. Elles passent ensuite 30 jours dans « Supprimés récemment » de Photos : l’espace revient après, ou quand vous le videz."
          }
        }
      }
    },
    "cart.snapshots_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS measures each snapshot’s private blocks. Selecting all Time Machine snapshots also includes blocks shared between them. For a partial selection, the sum of private sizes is a minimum. The report tracks the actual change in immediately free space."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS mesure les blocs privés de chaque snapshot. La sélection de tous les snapshots Time Machine inclut aussi les blocs partagés entre eux. Pour une sélection partielle, la somme des tailles privées est un minimum. Le bilan suit la variation réelle du libre immédiat."
          }
        }
      }
    },
