    "rule.photos.duplicate.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other copy stays in your library; this one stays 30 days in Recently Deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre exemplaire reste dans votre photothèque ; celui-ci reste 30 jours dans « Supprimés récemment »."
          }
        }
      }
    },
    "rule.photos.duplicate.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate photo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo en double"
          }
        }
      }
    },
    "rule.photos.duplicate.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact copy of another item in your library: same original files, byte for byte. Oust! never checks a copy for you, and always leaves at least one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie exacte d’un autre élément de votre photothèque : mêmes fichiers d’origine, octet pour octet. Oust! ne coche jamais de copie à votre place, et en laisse toujours au moins une."
          }
        }
      }
    },
    "rule.photos.screen_recording.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos keeps it 30 days in Recently Deleted. With iCloud Photos, deleting it also removes it from your other devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos le garde 30 jours dans « Supprimés récemment ». Avec Photos iCloud, le supprimer le retire aussi de vos autres appareils."
          }
        }
      }
    },
    "rule.photos.screen_recording.title": {
