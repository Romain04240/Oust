    "photos.similar_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bursts and series: photos taken within minutes of each other that look alike. Vision compares them on this Mac, from the thumbnails Photos already keeps here. On a large library, it takes a while."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafales et séries : des photos prises à quelques minutes d’écart qui se ressemblent. Vision les compare sur ce Mac, à partir des vignettes que Photos y garde déjà. Sur une grande photothèque, cela prend un moment."
          }
        }
      }
    },
    "photos.similar_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
