    "settings.trashed.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! looks the way the uninstaller does, then shows you what it found. Nothing is removed without your review. An update, or an app with another copy still installed, triggers nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust! cherche comme le désinstalleur, puis vous montre ce qu’il a trouvé. Rien n’est retiré sans votre revue. Une mise à jour, ou une application dont une autre copie reste installée, ne déclenche rien."
          }
        }
      }
    },
    "settings.trashed.needs_access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Full Disk Access: without it, macOS doesn’t let Oust! read the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande l’Accès complet au disque : sans lui, macOS ne laisse pas Oust! lire la corbeille du Mac."
          }
        }
      }
    },
