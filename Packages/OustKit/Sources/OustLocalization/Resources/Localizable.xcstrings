        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans chaque groupe, Oust! garde un exemplaire — l’original selon ses règles, ou le plus ancien au chemin le plus court quand rien ne les départage — et coche les autres."
          }
        }
      }
    },
