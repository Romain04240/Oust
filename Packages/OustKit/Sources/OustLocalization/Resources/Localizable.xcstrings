    "mcp.param.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return at most this many items, largest first; the token only covers what is returned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre au plus ce nombre d’éléments, les plus gros d’abord ; le jeton ne couvre que ce qui est rendu."
          }
        }
      }
    },
    "mcp.param.paths": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only keep items inside these folders (absolute, ~ or relative to the server’s folder)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne garder que les éléments dans ces dossiers (absolus, ~ ou relatifs au dossier du serveur)."
          }
        }
      }
    },
    "mcp.param.token": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview token returned by scan, valid for 30 minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton d’aperçu rendu par scan, valable 30 minutes."
          }
        }
      }
    },
    "mcp.tool.clean.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean items shown by a scan, through Oust!’s engine: each one is checked again right before it goes (still there, unchanged, no process working in it, allowed path), then logged in Oust!’s history. Refuses everything if one item is not allowed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer des éléments montrés par une analyse, par le moteur d’Oust! : chacun est revérifié juste avant de partir (toujours là, inchangé, aucun processus dedans, chemin autorisé), puis journalisé dans l’historique d’Oust!. Refuse tout si un seul élément n’est pas permis."
          }
        }
      }
    },
    "mcp.tool.clean.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer"
          }
        }
      }
    },
    "mcp.tool.explain.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain an item or a rule: what it is, how it comes back, what Oust! will do with it, and why it may be protected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliquer un élément ou une règle : ce que c’est, comment ça revient, ce qu’Oust! en fera, et pourquoi il est peut-être protégé."
          }
        }
      }
    },
    "mcp.tool.explain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explain"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliquer"
          }
        }
      }
    },
    "mcp.tool.scan.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dry-run analysis of developer and AI-agent clutter (build artifacts, package caches, Xcode, simulators, worktrees, models…). Touches nothing; returns items with freeable size, safety class, method, rebuild cost and protections, plus a preview token for clean."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse à blanc du désordre des outils de développement et des agents IA (artefacts de construction, caches de paquets, Xcode, simulateurs, worktrees, modèles…). Ne touche à rien ; rend les éléments avec taille libérable, classe de sécurité, méthode, coût de reconstruction et protections, et un jeton d’aperçu pour clean."
          }
        }
      }
    },
    "mcp.tool.scan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
