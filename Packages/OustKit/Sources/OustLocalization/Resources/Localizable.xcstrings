      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A simulator whose runtime is gone: it can no longer start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un simulateur dont le runtime a disparu : il ne peut plus démarrer."
          }
        }
      }
    },
    "rule.snapshot.time_machine.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back; your backups on a Time Machine disk are not affected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas ; vos sauvegardes sur un disque Time Machine ne sont pas touchées."
          }
        }
      }
    },
    "rule.snapshot.time_machine.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Machine snapshot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot Time Machine"
          }
        }
      }
    },
    "rule.snapshot.time_machine.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local snapshot taken hourly and kept 24 hours. It holds on to everything deleted since it was taken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un snapshot local pris chaque heure et gardé 24 heures. Il retient tout ce qui a été supprimé depuis."
          }
        }
      }
    },
    "rule.tool.brew_cleanup.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to bring back: current versions stay, and Homebrew leaves pinned formulae alone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à faire revenir : les versions actuelles restent, et Homebrew laisse de côté les formules épinglées."
          }
        }
      }
    },
    "rule.tool.brew_cleanup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old Homebrew versions"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciennes versions Homebrew"
          }
        }
      }
    },
    "rule.tool.brew_cleanup.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older versions of formulae and casks that Homebrew no longer links, as listed by brew cleanup --dry-run. Homebrew runs this cleanup by itself every 30 days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes versions de formules et de casks que Homebrew ne relie plus, telles que brew cleanup --dry-run les liste. Homebrew fait lui-même ce ménage tous les 30 jours."
          }
        }
      }
    },
    "rule.trash.contents.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas."
          }
        }
      }
    },
    "rule.trash.contents.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’s Trash"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbeille du Mac"
          }
        }
      }
    },
    "rule.trash.contents.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is already in the Mac’s Trash. Emptying it is final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est déjà dans la corbeille du Mac. La vider est définitif."
          }
        }
      }
    },
    "rule.trash.volume.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won’t come back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne reviendra pas."
          }
        }
      }
    },
    "rule.trash.volume.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash on this disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbeille de ce disque"
          }
        }
      }
    },
    "rule.trash.volume.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you threw away from this disk. The Finder keeps it on the disk itself, in a hidden folder (.Trashes), until the Mac’s Trash is emptied — that is often why a disk stays full after a big clean-up in the Finder. Emptying it is final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez jeté depuis ce disque. Le Finder le garde sur le disque même, dans un dossier caché (.Trashes), jusqu’à ce que la corbeille du Mac soit vidée — c’est souvent pourquoi un disque reste plein après un grand ménage dans le Finder. La vider est définitif."
          }
        }
      }
    },
    "rule.uninstall.app.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes to the Mac’s Trash: Put Back restores it, or reinstall it from its publisher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il part dans la corbeille du Mac : « Remettre » le rend, sinon on le réinstalle depuis son éditeur."
          }
        }
      }
    },
    "rule.uninstall.app.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application"
