    "rule.photos.similar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar photo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo similaire"
          }
        }
      }
    },
    "rule.photos.similar.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo that looks like others taken within minutes of it — a burst, a series. Vision compares them on this Mac. They aren’t identical: only you can choose which to keep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo qui ressemble à d’autres prises dans les mêmes minutes — une rafale, une série. Vision les compare sur ce Mac. Elles ne sont pas identiques : à vous de choisir lesquelles garder."
          }
        }
      }
    },
    "rule.photos.utility.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos keeps it 30 days in Recently Deleted. With iCloud Photos, deleting it also removes it from your other devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos la garde 30 jours dans « Supprimés récemment ». Avec Photos iCloud, la supprimer la retire aussi de vos autres appareils."
          }
        }
