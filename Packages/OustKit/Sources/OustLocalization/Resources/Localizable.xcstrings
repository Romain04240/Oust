    "agent.error.journalUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oust!’s history can’t be written (%@): nothing was cleaned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique d’Oust! ne peut pas être écrit (%@) : rien n’a été nettoyé."
          }
        }
      }
    },
