    "rule.attachments.messages.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, videos and files received in Messages, grouped by year. Conversations stay; the attachment shows as missing in them. Attachments from the last 30 days are left out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, vidéos et fichiers reçus dans Messages, regroupés par année. Les conversations restent ; la pièce jointe y apparaît manquante. Celles des 30 derniers jours sont laissées de côté."
          }
        }
      }
    },
