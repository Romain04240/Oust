    "trashed.strict_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found the way the uninstaller finds them: this app’s exact identifier, its name when no other app has it, or what macOS confirms belongs to it. Kept aside: what another app on this Mac may still use, and anything changed after the app went to the Trash. Everything goes to the Mac’s Trash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvés comme le fait le désinstalleur : l’identifiant exact de l’application, son nom quand aucune autre ne le porte, ou ce que macOS confirme lui appartenir. Mis de côté : ce qu’une autre application de ce Mac peut encore utiliser, et ce qui a changé après son départ à la corbeille. Tout part dans la corbeille du Mac."
          }
        }
      }
    },
